rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }
    
    function isStudent() {
      return isAuthenticated() && getUserData().role == 'student';
    }
    
    function isTeacherOrAdmin() {
      return isAdmin() || isTeacher();
    }

    // Accounts an admin has put on hold or suspended may not perform actions
    // (start/submit exams, create content). Missing `status` == active.
    function isActiveUser() {
      return isAuthenticated() && getUserData().get('status', 'active') == 'active';
    }

    // Deterministic per-student-per-exam attempt counter document ID,
    // shared by the examAttemptCounters rules and the examSessions create
    // rule below (Task 4 — exam attempt limits).
    function attemptCounterId(examId, studentId) {
      return examId + '_' + studentId;
    }

    // Is the requesting teacher one this student is actually assigned to?
    // (Phase 2 Feature 6.) Looks up the STUDENT's own assignedTeacherIds
    // rather than requiring a denormalized teacher->students list — reuses
    // the same field Task 10 already maintains.
    function isAssignedToStudent(studentId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(studentId)).data.get('assignedTeacherIds', []);
    }
    
    // Users collection
    match /users/{userId} {
      // Authenticated users (students, teachers, admins) can read user profiles
      allow read: if isAuthenticated();
      
      // Users can only create their own document during registration
      allow create: if isUser(userId) && 
                      request.resource.data.id == userId &&
                      request.resource.data.email == request.auth.token.email &&
                      request.resource.data.role in ['student', 'teacher'] &&
                      (!request.resource.data.keys().hasAny(['approved']) || 
                       request.resource.data.role == 'student' && request.resource.data.approved == true ||
                       request.resource.data.role == 'teacher' && request.resource.data.approved == false);
      
      // Users can update their own profile (except role/approval status and
      // access-control fields). `assignedTeacherIds` MUST stay server-owned:
      // it is what the notices and exam rules trust to decide which teacher's
      // content a student may read, so a self-writable value would let any
      // student grant themselves another teacher's communications. It is
      // written only by the Admin SDK via /api/classroom/sync-access and the
      // admin assignment flow.
      allow update: if isUser(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approved', 'rejected', 'id', 'assignedTeacherIds', 'status']);
      
      // Admins can update any user (for approval/rejection)
      allow update: if isAdmin();
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // Pending Registrations collection (email-verification flow)
    // This collection is written ONLY by the Firebase Admin SDK (server-side
    // API routes) using server credentials, which bypass security rules.
    // Clients must never read or write these sensitive records.
    match /pendingRegistrations/{registrationId} {
      allow read, write: if false;
    }
    
    // Exams collection
    match /exams/{examId} {
      // Teachers can read their own exams (any status).
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      // Admins can read any exam.
      allow read: if isAdmin();
      // Students can only read an exam they were specifically targeted for —
      // `targetStudentIds` is resolved at creation time from the teacher's
      // Course+Batch+Section assignment (see computeAssignmentTargetStudentIds
      // in lib/firebase/assignments.ts). Exams created before this field
      // existed stay invisible until an admin runs the one-time
      // backfillExamTargetStudentIds() — same fail-closed-until-backfilled
      // tradeoff already used for `assignedTeacherIds`.
      //
      // `completed`/`archived` are included deliberately: a student must be
      // able to re-open /exam/{id}/review after the teacher closes the exam,
      // and ExamClient re-reads the exam doc while grading a submission. The
      // listing query (subscribeToStudentVisibleExams) filters to
      // published/active itself, so a closed exam still never appears as
      // startable — this only keeps already-earned results readable.
      allow read: if isStudent() &&
                     resource.data.status in ['published', 'active', 'completed', 'archived'] &&
                     request.auth.uid in resource.data.get('targetStudentIds', []);

      // Teachers can create exams
      allow create: if isTeacher() && isActiveUser() &&
                       request.resource.data.teacherId == request.auth.uid &&
                       request.resource.data.status in ['draft', 'published'];

      // Teachers can update their own exams
      allow update: if isTeacher() && isActiveUser() && resource.data.teacherId == request.auth.uid;
      
      // Admins can update/delete any exam
      allow update, delete: if isAdmin();
      
      // Teachers can delete their own exams
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }
    
    // Questions collection
    match /questions/{questionId} {
      // Staff can read any question (needed by the exam builder/review UIs).
      allow read: if isTeacherOrAdmin();
      // A student may only read questions belonging to an exam they were
      // actually targeted for. This used to be `isAuthenticated()`, which let
      // any signed-in student pull `correctAnswer` for EVERY exam in the
      // system — including drafts and other sections — straight out of this
      // collection, completely bypassing the exams read rule.
      allow read: if isStudent() &&
                     request.auth.uid in get(/databases/$(database)/documents/exams/$(resource.data.examId)).data.get('targetStudentIds', []);
      
      // Teachers can create questions for their exams
      allow create: if isTeacher() && 
                       exists(/databases/$(database)/documents/exams/$(request.resource.data.examId)) &&
                       get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.teacherId == request.auth.uid;
      
      // Teachers can update/delete questions for their exams
      allow update, delete: if isTeacher() && 
                               exists(/databases/$(database)/documents/exams/$(resource.data.examId)) &&
                               get(/databases/$(database)/documents/exams/$(resource.data.examId)).data.teacherId == request.auth.uid;
      
      // Admins can do everything
      allow update, delete: if isAdmin();
    }
    
    // Exam Sessions collection
    match /examSessions/{sessionId} {
      // Students can read their own sessions
      allow read: if isUser(resource.data.studentId);
      
      // Teachers and admins can read sessions for monitoring and evaluation
      allow read: if isTeacherOrAdmin();
      
      // Students can create their own sessions. attemptNumber must be a
      // positive integer within the exam's attemptsAllowed cap, and must
      // equal (pre-write counter value + 1) / 1 if no counter exists yet.
      // The client writes the matching examAttemptCounters update in the
      // same transaction (see ExamClient.startExam) — since rule `get()`
      // calls inside a transaction see the pre-transaction snapshot, this
      // is safe against a crafted client trying to skip the counter or
      // claim an attempt number a real transaction wouldn't produce.
      allow create: if isAuthenticated() && isActiveUser() &&
               request.resource.data.studentId == request.auth.uid &&
               exists(/databases/$(database)/documents/exams/$(request.resource.data.examId)) &&
               request.resource.data.attemptNumber is int &&
               request.resource.data.attemptNumber >= 1 &&
               request.resource.data.attemptNumber <=
                 get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.get('attemptsAllowed', 1) &&
               request.resource.data.attemptNumber == (
                 exists(/databases/$(database)/documents/examAttemptCounters/$(attemptCounterId(request.resource.data.examId, request.auth.uid)))
                   ? get(/databases/$(database)/documents/examAttemptCounters/$(attemptCounterId(request.resource.data.examId, request.auth.uid))).data.count + 1
                   : 1
               );

      // Students can update their own sessions
      allow update: if isUser(resource.data.studentId) && isActiveUser();

      // Teachers and admins can update sessions for monitoring
      allow update: if isTeacherOrAdmin() && isActiveUser();
    }

    // Exam attempt counters — one document per (exam, student) pair,
    // backing the attempt-limit enforcement above (Task 4).
    match /examAttemptCounters/{counterId} {
      // `resource == null` short-circuits before dereferencing `.data` — a
      // student's first attempt at any exam reads this doc before it exists
      // (see ExamClient.startExam's transaction), and resource.data.X on a
      // nonexistent doc throws in rules, which is treated as a denial. That
      // was silently blocking every first attempt.
      allow read: if isTeacherOrAdmin() ||
        (isAuthenticated() && (resource == null || resource.data.studentId == request.auth.uid));
      allow create: if isAuthenticated() && isActiveUser() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.count == 1;
      allow update: if isAuthenticated() && isActiveUser() &&
        resource.data.studentId == request.auth.uid &&
        request.resource.data.count == resource.data.count + 1;
    }

    // Answers collection
    match /answers/{answerId} {
      // Students can read their own answers
      allow read: if isUser(resource.data.studentId);
      
      // Teachers and admins can read answers
      allow read: if isTeacherOrAdmin();
      
      // Students can create/update their own answers
      allow create, update: if isAuthenticated() && isActiveUser() &&
               request.resource.data.studentId == request.auth.uid &&
               exists(/databases/$(database)/documents/examSessions/$(request.resource.data.examSessionId)) &&
               get(/databases/$(database)/documents/examSessions/$(request.resource.data.examSessionId)).data.studentId == request.auth.uid;

      // Teachers and admins can update answers (for grading, OCR analysis & similarity reports)
      allow update: if isTeacherOrAdmin() && isActiveUser();
    }

    // Similarity Reports collection
    match /similarityReports/{reportId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isTeacherOrAdmin();
    }

    // ============ Live Exam Video (see lib/services/liveVideo.ts) ============

    // WebRTC signaling: the student publishes offers/ICE, each watching teacher
    // registers a presence document under `viewers` and answers there.
    match /liveVideoSignaling/{sessionId} {
      allow read: if isAuthenticated();
      // Only the broadcasting student (or staff) may own the room document.
      allow create, update: if isTeacherOrAdmin() ||
        (isAuthenticated() && request.resource.data.studentId == request.auth.uid);
      allow delete: if isTeacherOrAdmin() ||
        (isAuthenticated() && resource.data.studentId == request.auth.uid);

      match /viewers/{viewerId}/{allPaths=**} {
        // Signaling payloads are ephemeral SDP/ICE blobs; both peers need
        // read/write access to complete the handshake.
        allow read, write: if isAuthenticated();
      }
    }

    // Firestore frame relay — the transport that makes live video work without
    // a VPS/TURN server. Written by the student, read by teachers/admins.
    match /liveFrames/{sessionId} {
      allow read: if isTeacherOrAdmin() ||
        (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create, update: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid;
      allow delete: if isTeacherOrAdmin() ||
        (isAuthenticated() && resource.data.studentId == request.auth.uid);
    }
    
    // Exam Logs collection
    match /examLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Proctoring Events collection
    match /proctoringEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Proctoring Snapshots collection
    match /proctoringSnapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    // Warning Screenshots collection — permanent proctoring evidence
    // captured on every warning (Task 9's Snapshots gallery).
    match /warningScreenshots/{screenshotId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isTeacherOrAdmin();
    }

    // Settings collection (admin only)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============ Course / Batch / Section Management ============

    // Courses collection
    match /courses/{courseId} {
      // Any authenticated user can read courses (needed for forms across teacher/student panels)
      allow read: if isAuthenticated();
      // Only admins can create/update/delete courses
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Batches collection
    match /batches/{batchId} {
      // Any authenticated user can read batches
      allow read: if isAuthenticated();
      // Only admins can create/update/delete batches
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Sections collection
    match /sections/{sectionId} {
      // Any authenticated user can read sections
      allow read: if isAuthenticated();
      // Only admins can create/update/delete sections
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Teacher Applications collection (optional)
    match /teacherApplications/{applicationId} {
      allow read: if isAdmin() || isUser(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============ Results Module ============

    // Results collection
    match /results/{resultId} {
      // Students can only read their own published results
      allow read: if isStudent() && resource.data.studentId == request.auth.uid && resource.data.isPublished == true;
      // Teachers can only read results for their own assigned students —
      // the comment here used to claim "via batch/section filtering" but no
      // such check actually existed, letting any teacher read any student's
      // results (Phase 2 Feature 6 audit finding).
      allow read: if isTeacher() && isAssignedToStudent(resource.data.studentId);
      // Admins can read all results
      allow read: if isAdmin();
      // Only teachers and admins can create results
      allow create: if isTeacherOrAdmin() && request.resource.data.studentId != null;
      // Only teachers and admins can update results
      allow update: if isTeacherOrAdmin();
      // Only admins can delete results
      allow delete: if isAdmin();
    }

    // Student Warnings collection
    match /studentWarnings/{warningId} {
      // Students can only read their own warnings
      allow read: if isStudent() && resource.data.studentId == request.auth.uid;
      // Teachers can only read warnings for their own assigned students
      // (Phase 2 Feature 6 audit finding — same gap as `results` above).
      allow read: if isTeacher() && isAssignedToStudent(resource.data.studentId);
      // Admins can read all warnings
      allow read: if isAdmin();
      // Only teachers and admins can create warnings
      allow create: if isTeacherOrAdmin() && request.resource.data.studentId != null;
      // Only teachers and admins can update warnings
      allow update: if isTeacherOrAdmin();
      // Only admins can delete warnings
      allow delete: if isAdmin();
    }

    // Result Notifications collection (for real-time update signaling).
    // Not currently written or read by any app code (confirmed unused,
    // Phase 2 Feature 6 audit), but `allow read: if isAuthenticated()` let
    // any signed-in student read every other student's signal — tightened
    // to staff-only in case this is wired up later.
    match /resultNotifications/{notificationId} {
      allow read: if isTeacherOrAdmin();
      allow create: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    // ============ Notice Module ============

    // Notices collection
    match /notices/{noticeId} {
      // Students can only read PUBLISHED notices that are actually addressed to
      // them AND whose teacher is one an admin actually assigned this student
      // to (Task 10 — teacher communication only reaches assigned students).
      // These conditions mirror the queries in getStudentNotices() — keep
      // the two in sync or student notice lists will fail with permission-denied.
      allow read: if isStudent() &&
                     resource.data.status == 'published' &&
                     resource.data.teacherId in getUserData().get('assignedTeacherIds', []) && (
                       resource.data.targetType == 'all' ||
                       (resource.data.targetType == 'individual' &&
                        request.auth.uid in resource.data.get('targetStudentIds', [])) ||
                       (resource.data.targetType in ['batch', 'semester'] &&
                        resource.data.get('targetBatch', '') == getUserData().get('batch', '')) ||
                       (resource.data.targetType == 'section' &&
                        resource.data.get('targetSection', '') == getUserData().get('section', '')) ||
                       (resource.data.targetType == 'course' &&
                        resource.data.get('targetCourseId', '') in getUserData().get('courses', []))
                     );
      // Teachers can read their own notices (draft or published)
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      // Admins can read all notices
      allow read: if isAdmin();
      // Teachers can create notices
      allow create: if isTeacher() && isActiveUser() &&
                       request.resource.data.teacherId == request.auth.uid &&
                       request.resource.data.status in ['draft', 'published'];
      // Teachers can update their own notices
      allow update: if isTeacher() && isActiveUser() && resource.data.teacherId == request.auth.uid;
      // Admins can update any notice
      allow update: if isAdmin();
      // Teachers can delete their own notices
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
      // Admins can delete any notice
      allow delete: if isAdmin();
    }

    // Notice Reads collection
    match /noticeReads/{readId} {
      // Students can read their own read status
      allow read: if isStudent() && resource.data.studentId == request.auth.uid;
      // Teachers can read read status for their notices
      allow read: if isTeacher();
      // Admins can read all
      allow read: if isAdmin();
      // Students can mark notices as read
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      // Staff clean these up when a notice is deleted (without this, deleting a
      // notice that anyone had read failed with permission-denied).
      allow delete: if isTeacherOrAdmin();
    }

// Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Staff can read them to report delivery and to clean up deleted notices
      allow read: if isTeacherOrAdmin();
      // Teachers and admins create notifications when publishing notices
      allow create: if isTeacherOrAdmin() &&
                       request.resource.data.type == 'notice' &&
                       request.resource.data.userId != null &&
                       request.resource.data.noticeId != null;
      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // Admin can manage
      allow update: if isAdmin();
      // Staff remove a notice's notifications when the notice is deleted.
      allow delete: if isTeacherOrAdmin();
    }

    // ============ Teacher Assignment Module ============

    // teacher_assignments collection
    match /teacher_assignments/{assignmentId} {
      // Teachers can read their own assignments
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      // Admins can read all assignments
      allow read: if isAdmin();
      // Only admins can create/update/delete assignments
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // teacher_student_mapping collection
    match /teacher_student_mapping/{mappingId} {
      // Teachers can read mappings where they are the teacher
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      // Admins can read all mappings
      allow read: if isAdmin();
      // Only admins can create/update/delete mappings
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============ Classroom Module (Phase 2, Feature 1) ============

    function isClassroomMember(classroomId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/classroomMembers/$(classroomId + '_' + request.auth.uid));
    }

    // Classrooms collection
    match /classrooms/{classroomId} {
      // Broad read: needed so a student can look up a classroom by code
      // before joining, and so "already joined" checks work. The classroom
      // doc itself (name/subject/code) is not sensitive; content (posts,
      // classwork, roster) is gated separately below.
      allow read: if isAuthenticated();
      allow create: if isTeacher() && isActiveUser() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow update, delete: if isAdmin();
      // A joining/leaving student must be able to move the roster counter by
      // exactly one. joinClassroomByCode/leaveClassroom commit the member doc
      // and this counter in a single atomic batch — without this branch the
      // WHOLE batch was rejected, which is why joining and leaving both
      // failed with a misleading "not allowed to join" error.
      allow update: if isStudent() && isActiveUser() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentCount', 'updatedAt']) &&
        request.resource.data.studentCount is int &&
        request.resource.data.studentCount >= 0 &&
        (request.resource.data.studentCount == resource.data.get('studentCount', 0) + 1 ||
         request.resource.data.studentCount == resource.data.get('studentCount', 0) - 1);
    }

    // Classroom membership ("People" tab / joined students). Document id is
    // deterministic `${classroomId}_${studentId}` — this both stops
    // duplicate joins (a second `create` on the same id is an `update`,
    // which this rule doesn't grant to students) and lets other collections
    // cheaply check "is this student a member" via exists().
    match /classroomMembers/{memberId} {
      // Staff, the member themself, or any fellow member of the same
      // classroom (so the People tab roster loads for students — previously
      // a student's roster query was denied outright and the tab silently
      // rendered "No students found").
      allow read: if isTeacherOrAdmin() ||
        (isAuthenticated() && resource.data.studentId == request.auth.uid) ||
        isClassroomMember(resource.data.classroomId);
      // Self-join by code: classroom membership is its own access boundary
      // now (no separate admin Course/Batch/Section assignment required —
      // see lib/firebase/classrooms.ts#joinClassroomByCode). The submitted
      // `teacherId` must match the classroom's real owner so the
      // denormalized field recomputeAssignedTeacherIds() relies on can't be
      // spoofed.
      allow create: if isStudent() && isActiveUser() &&
        request.resource.data.studentId == request.auth.uid &&
        memberId == request.resource.data.classroomId + '_' + request.auth.uid &&
        request.resource.data.teacherId == get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId &&
        get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.status == 'active';
      // Teacher-initiated add (manual, or Course/Batch/Section bulk-add) —
      // only the classroom's own teacher, or an admin, may add a student
      // this way.
      allow create: if (
          (isTeacher() && get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId == request.auth.uid) ||
          isAdmin()
        ) &&
        memberId == request.resource.data.classroomId + '_' + request.resource.data.studentId &&
        request.resource.data.teacherId == get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId &&
        get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.status == 'active';
      // Student leaves, or teacher/admin removes them.
      allow delete: if isTeacherOrAdmin() ||
        (isAuthenticated() && resource.data.studentId == request.auth.uid);
    }

    // Stream posts (announcements/notices/materials)
    match /classroomPosts/{postId} {
      allow read: if isTeacherOrAdmin() || isClassroomMember(resource.data.classroomId);
      allow create: if isTeacher() && isActiveUser() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Stream comments
    match /classroomComments/{commentId} {
      allow read: if isTeacherOrAdmin() || isClassroomMember(resource.data.classroomId);
      allow create: if isAuthenticated() && isActiveUser() &&
        request.resource.data.authorId == request.auth.uid &&
        (isTeacherOrAdmin() || isClassroomMember(request.resource.data.classroomId));
      allow delete: if isTeacherOrAdmin() ||
        (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Classwork (assignments/quizzes/materials/resources/links)
    match /classroomClasswork/{itemId} {
      // Students only ever see published classwork; drafts are teacher-only.
      allow read: if isTeacherOrAdmin() ||
        (resource.data.status == 'published' && isClassroomMember(resource.data.classroomId));
      allow create: if isTeacher() && isActiveUser() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Email delivery log for classroom notifications — written by the
    // server (Admin SDK, /api/classroom/notify) which bypasses rules;
    // these rules only cover the (currently unused) direct-client path.
    match /classroomEmailLogs/{logId} {
      allow read: if isTeacherOrAdmin();
      allow create: if isTeacherOrAdmin();
    }
  }
}
