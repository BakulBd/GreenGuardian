rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }
    
    function isStudent() {
      return isAuthenticated() && getUserData().role == 'student';
    }
    
    function isTeacherOrAdmin() {
      return isAdmin() || isTeacher();
    }

    // Accounts an admin has put on hold or suspended may not perform actions
    // (start/submit exams, create content). Missing `status` == active.
    function isActiveUser() {
      return isAuthenticated() && getUserData().get('status', 'active') == 'active';
    }

    // Deterministic per-student-per-exam attempt counter document ID,
    // shared by the examAttemptCounters rules and the examSessions create
    // rule below (Task 4 — exam attempt limits).
    function attemptCounterId(examId, studentId) {
      return examId + '_' + studentId;
    }

    /**
     * True when the requested document does not exist.
     *
     * A document that is not there discloses nothing, but a rule that reaches
     * for `resource.data.X` on a missing document RAISES, and a raise is a
     * denial. Every "does this exist?" probe therefore fails as
     * permission-denied unless a rule says otherwise — which is a bug that has
     * now been found four separate times in this project (first attempt at an
     * exam, first classroom join, first assignment hand-in, and opening a
     * result by session id). Collections whose ids clients legitimately probe
     * carry an explicit branch for it.
     */
    function isMissingDoc() {
      return resource == null;
    }

    // Is the requesting teacher one this student is actually assigned to?
    // (Phase 2 Feature 6.) Looks up the STUDENT's own assignedTeacherIds
    // rather than requiring a denormalized teacher->students list — reuses
    // the same field Task 10 already maintains.
    function isAssignedToStudent(studentId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(studentId)).data.get('assignedTeacherIds', []);
    }
    
    // Users collection
    match /users/{userId} {
      // Authenticated users (students, teachers, admins) can read user profiles
      allow read: if isAuthenticated();
      
      // Users can only create their own document during registration
      allow create: if isUser(userId) && 
                      request.resource.data.id == userId &&
                      request.resource.data.email == request.auth.token.email &&
                      request.resource.data.role in ['student', 'teacher'] &&
                      (!request.resource.data.keys().hasAny(['approved']) || 
                       request.resource.data.role == 'student' && request.resource.data.approved == true ||
                       request.resource.data.role == 'teacher' && request.resource.data.approved == false);
      
      // Users can update their own profile — name, phone, avatar, and the
      // mustChangePassword acknowledgement. Everything that decides ACCESS is
      // excluded and stays server/admin-owned:
      //
      //   role, approved, rejected, id, status
      //     — identity and account state.
      //   assignedTeacherIds
      //     — the field the notice and exam rules trust to decide whose content
      //       a student may read. Self-writable, it would let any student grant
      //       themselves another teacher's communications. Written only by the
      //       Admin SDK (lib/server/roster.ts, /api/classroom/sync-access).
      //   batch, section, sections, studentCode, department
      //     — academic placement. This is the INPUT the roster is derived from,
      //       so leaving it self-writable is the same hole one step removed: a
      //       student could move into any section and pick up that section's
      //       exams and notices on the next roster sync. Changed by an admin
      //       via the Students page, which resyncs the roster with it.
      allow update: if isUser(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                         'role', 'approved', 'rejected', 'id', 'status',
                         'assignedTeacherIds',
                         'batch', 'section', 'sections', 'studentCode', 'department'
                       ]);
      
      // Admins can update any user (for approval/rejection)
      allow update: if isAdmin();
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // Pending Registrations collection (email-verification flow)
    // This collection is written ONLY by the Firebase Admin SDK (server-side
    // API routes) using server credentials, which bypass security rules.
    // Clients must never read or write these sensitive records.
    match /pendingRegistrations/{registrationId} {
      allow read, write: if false;
    }
    
    // Batch-wise student ID sequences (lib/server/student-ids.ts).
    //
    // Written ONLY by the Admin SDK, which bypasses these rules. Client access
    // is denied outright: a client that could write a counter could rewind it
    // and mint a duplicate student ID, and one that could only read it still
    // learns the exact size of every batch for nothing in return.
    match /studentCodeCounters/{counterId} {
      allow read, write: if false;
    }

    // Exams collection
    match /exams/{examId} {
      // Teachers can read their own exams (any status).
      allow read: if isTeacher() && (resource.data.teacherId == request.auth.uid || resource.data.createdBy == request.auth.uid);
      // Admins can read any exam.
      allow read: if isAdmin();
      // Students can only read an exam they were specifically targeted for —
      // `targetStudentIds` is resolved at creation time from the teacher's
      // Course+Batch+Section assignment (see computeAssignmentTargetStudentIds
      // in lib/firebase/assignments.ts). Exams created before this field
      // existed stay invisible until an admin runs the one-time
      // backfillExamTargetStudentIds() — same fail-closed-until-backfilled
      // tradeoff already used for `assignedTeacherIds`.
      //
      // `completed`/`archived` are included deliberately: a student must be
      // able to re-open /exam/{id}/review after the teacher closes the exam,
      // and ExamClient re-reads the exam doc while grading a submission. The
      // listing query (subscribeToStudentVisibleExams) filters to
      // published/active itself, so a closed exam still never appears as
      // startable — this only keeps already-earned results readable.
      allow read: if isStudent() &&
                     resource.data.status in ['published', 'active', 'completed', 'archived'] &&
                     request.auth.uid in resource.data.get('targetStudentIds', []);

      // Teachers can create exams
      allow create: if isTeacher() && isActiveUser() &&
                       request.resource.data.teacherId == request.auth.uid &&
                       request.resource.data.status in ['draft', 'published'];

      // Teachers can update their own exams
      allow update: if isTeacher() && isActiveUser() && (resource.data.teacherId == request.auth.uid || resource.data.createdBy == request.auth.uid);
      
      // Admins can update/delete any exam
      allow update, delete: if isAdmin();
      
      // Teachers can delete their own exams
      allow delete: if isTeacher() && (resource.data.teacherId == request.auth.uid || resource.data.createdBy == request.auth.uid);
    }
    
    // Questions collection
    match /questions/{questionId} {
      // Staff can read any question (needed by the exam builder/review UIs).
      //
      // Students get NO read access here at all. Question documents carry
      // `correctAnswer`, and no rule can hand a student the question text
      // without also handing them the key. Their paper is served instead by
      // `/api/exams/paper`, which strips the key server-side, and their
      // submission is graded by `/api/exams/grade`, which reads this
      // collection with the Admin SDK. After submitting, the answer key
      // reaches the student through `answers/{id}.questionSnapshot` — written
      // by the grading route, once the attempt is over.
      allow read: if isTeacherOrAdmin();

      // Teachers can create questions for their exams
      allow create: if isTeacher() && 
                       exists(/databases/$(database)/documents/exams/$(request.resource.data.examId)) &&
                       get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.teacherId == request.auth.uid;
      
      // Teachers can update/delete questions for their exams
      allow update, delete: if isTeacher() && 
                               exists(/databases/$(database)/documents/exams/$(resource.data.examId)) &&
                               get(/databases/$(database)/documents/exams/$(resource.data.examId)).data.teacherId == request.auth.uid;
      
      // Admins can do everything
      allow update, delete: if isAdmin();
    }
    
    // Exam Sessions collection
    match /examSessions/{sessionId} {
      // `getResultDetails()` probes results/{id} and then examSessions/{id}
      // with the same id, so one of the two is always a miss by design.
      allow read: if isAuthenticated() && isMissingDoc();

      // Students can read their own sessions
      allow read: if !isMissingDoc() && isUser(resource.data.studentId);

      // Teachers and admins can read sessions for monitoring and evaluation
      allow read: if isTeacherOrAdmin();
      
      // Students can create their own sessions. attemptNumber must be a
      // positive integer within the exam's attemptsAllowed cap, and must
      // equal (pre-write counter value + 1) / 1 if no counter exists yet.
      // The client writes the matching examAttemptCounters update in the
      // same transaction (see ExamClient.startExam) — since rule `get()`
      // calls inside a transaction see the pre-transaction snapshot, this
      // is safe against a crafted client trying to skip the counter or
      // claim an attempt number a real transaction wouldn't produce.
      allow create: if isAuthenticated() && isActiveUser() &&
               request.resource.data.studentId == request.auth.uid &&
               exists(/databases/$(database)/documents/exams/$(request.resource.data.examId)) &&
               request.resource.data.attemptNumber is int &&
               request.resource.data.attemptNumber >= 1 &&
               request.resource.data.attemptNumber <=
                 get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.get('attemptsAllowed', 1) &&
               request.resource.data.attemptNumber == (
                 exists(/databases/$(database)/documents/examAttemptCounters/$(attemptCounterId(request.resource.data.examId, request.auth.uid)))
                   ? get(/databases/$(database)/documents/examAttemptCounters/$(attemptCounterId(request.resource.data.examId, request.auth.uid))).data.count + 1
                   : 1
               );

      // Students can update their own sessions, but only the fields their own
      // browser is the source of: autosaved answers, the proctoring counters
      // its sensors produce, and the lifecycle transitions it drives
      // (resume, and closing out an attempt whose time expired offline).
      //
      // Every scoring field is excluded. `score`, `totalMarks`, `accuracy`,
      // `correctAnswers`, `wrongAnswers`, `grading`, `flagged`, … are written
      // ONLY by /api/exams/grade through the Admin SDK. Until this allowlist
      // existed, a student could PATCH their own session with `score: 100`:
      // grading ran in their browser, so the rules had no way to tell a real
      // score from an invented one, and simply trusted whatever arrived.
      allow update: if isUser(resource.data.studentId) && isActiveUser() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'savedAnswers', 'updatedAt', 'status', 'submitted',
                         'completedAt', 'reason', 'resumedAt',
                         'warnings', 'behaviorScore', 'violationCounts', 'proctoring'
                       ]);

      // Teachers and admins can update sessions for monitoring
      allow update: if isTeacherOrAdmin() && isActiveUser();
    }

    // Exam attempt counters — one document per (exam, student) pair,
    // backing the attempt-limit enforcement above (Task 4).
    match /examAttemptCounters/{counterId} {
      // `resource == null` short-circuits before dereferencing `.data` — a
      // student's first attempt at any exam reads this doc before it exists
      // (see ExamClient.startExam's transaction), and resource.data.X on a
      // nonexistent doc throws in rules, which is treated as a denial. That
      // was silently blocking every first attempt.
      allow read: if isTeacherOrAdmin() ||
        (isAuthenticated() && (resource == null || resource.data.studentId == request.auth.uid));
      allow create: if isAuthenticated() && isActiveUser() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.count == 1;
      allow update: if isAuthenticated() && isActiveUser() &&
        resource.data.studentId == request.auth.uid &&
        request.resource.data.count == resource.data.count + 1;
    }

    // Answers collection
    match /answers/{answerId} {
      // Students can read their own answers
      allow read: if isUser(resource.data.studentId);
      
      // Teachers and admins can read answers
      allow read: if isTeacherOrAdmin();
      
      // Submissions are CREATED server-side only (/api/exams/grade, Admin SDK,
      // which bypasses these rules). A student-created answer document was how
      // a submission used to arrive, carrying a browser-computed `score` that
      // nothing could verify — the document and its grade are now written
      // together by the server from the answer key.
      //
      // The one thing a student still writes here is the result of the
      // background OCR pass on their own upload-mode submission, which runs in
      // their browser after submitting.
      allow update: if isAuthenticated() && isActiveUser() &&
               resource.data.studentId == request.auth.uid &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'ocrAnalysis', 'ocrText', 'ocrStatus'
               ]);

      // Teachers and admins can update answers (for grading, OCR analysis & similarity reports)
      allow update: if isTeacherOrAdmin() && isActiveUser();
    }

    // Similarity Reports collection
    //
    // Written exclusively by /api/plagiarism/check via the Admin SDK. Client
    // writes are denied outright: this collection holds the verdict on whether
    // a student plagiarised, and `allow create, update: if isAuthenticated()`
    // let the accused student overwrite it with a clean score.
    //
    // Reads are STAFF-ONLY, including for the student the report is about: the
    // `matches` array names the classmates whose answers theirs resembled and
    // by how much. The student sees only their own verdict, via
    // `similarityScore`/`similarityLevel` on their answer document.
    match /similarityReports/{reportId} {
      allow read: if isTeacherOrAdmin();
      allow write: if false;
    }

    // ============ Live Exam Video (see lib/services/liveVideo.ts) ============

    // WebRTC signaling: the student publishes offers/ICE, each watching teacher
    // registers a presence document under `viewers` and answers there.
    match /liveVideoSignaling/{sessionId} {
      allow read: if isAuthenticated();
      // Only the broadcasting student (or staff) may own the room document.
      allow create, update: if isTeacherOrAdmin() ||
        (isAuthenticated() && request.resource.data.studentId == request.auth.uid);
      allow delete: if isTeacherOrAdmin() ||
        (isAuthenticated() && resource.data.studentId == request.auth.uid);

      match /viewers/{viewerId}/{allPaths=**} {
        // Signaling payloads are ephemeral SDP/ICE blobs; both peers need
        // read/write access to complete the handshake.
        allow read, write: if isAuthenticated();
      }
    }

    // Firestore frame relay — the transport that makes live video work without
    // a VPS/TURN server. Written by the student, read by teachers/admins.
    match /liveFrames/{sessionId} {
      allow read: if isTeacherOrAdmin() ||
        (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create, update: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid;
      allow delete: if isTeacherOrAdmin() ||
        (isAuthenticated() && resource.data.studentId == request.auth.uid);
    }
    
    // Exam Logs collection
    match /examLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Proctoring Events collection
    // Proctoring evidence (events, webcam snapshots, warning screenshots).
    //
    // Students WRITE these from the exam client but never read them back; only
    // the teacher invigilation surfaces do. Read used to be `isAuthenticated()`,
    // which let any signed-in student pull every other student's webcam
    // captures and violation history straight out of Firestore.
    // Own-session reads stay allowed so a student can still see their own
    // record if a future screen needs it.
    match /proctoringEvents/{eventId} {
      allow read: if isTeacherOrAdmin() || isUser(resource.data.studentId);
      allow create: if isAuthenticated();
    }

    // Proctoring Snapshots collection
    match /proctoringSnapshots/{snapshotId} {
      allow read: if isTeacherOrAdmin() || isUser(resource.data.studentId);
      allow create: if isAuthenticated();
    }

    // Warning Screenshots collection — permanent proctoring evidence
    // captured on every warning (Task 9's Snapshots gallery).
    match /warningScreenshots/{screenshotId} {
      allow read: if isTeacherOrAdmin() || isUser(resource.data.studentId);
      allow create: if isAuthenticated();
      allow delete: if isTeacherOrAdmin();
    }

    // Settings collection (admin only)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============ Course / Batch / Section Management ============

    // Courses collection
    match /courses/{courseId} {
      // Any authenticated user can read courses (needed for forms across teacher/student panels)
      allow read: if isAuthenticated();
      // Only admins can create/update/delete courses
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Batches collection
    match /batches/{batchId} {
      // Any authenticated user can read batches
      allow read: if isAuthenticated();
      // Only admins can create/update/delete batches
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Sections collection
    match /sections/{sectionId} {
      // Any authenticated user can read sections
      allow read: if isAuthenticated();
      // Only admins can create/update/delete sections
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Teacher Applications collection (optional)
    match /teacherApplications/{applicationId} {
      allow read: if isAdmin() || isUser(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============ Results Module ============

    // Results collection
    match /results/{resultId} {
      // A student opening a result by exam-session id lands here first and
      // misses; without this branch the miss was a permission error, the
      // caller's catch swallowed it, and the examSessions fallback that would
      // have rendered the result never ran. See getResultDetails().
      allow read: if isAuthenticated() && isMissingDoc();

      // Students can only read their own published results
      allow read: if !isMissingDoc() && isStudent() &&
        resource.data.studentId == request.auth.uid && resource.data.isPublished == true;
      // Teachers can only read results for their own assigned students —
      // the comment here used to claim "via batch/section filtering" but no
      // such check actually existed, letting any teacher read any student's
      // results (Phase 2 Feature 6 audit finding).
      allow read: if !isMissingDoc() && isTeacher() && isAssignedToStudent(resource.data.studentId);
      // Admins can read all results
      allow read: if isAdmin();
      // Only teachers and admins can create results
      allow create: if isTeacherOrAdmin() && request.resource.data.studentId != null;
      // Only teachers and admins can update results
      allow update: if isTeacherOrAdmin();
      // Only admins can delete results
      allow delete: if isAdmin();
    }

    // Student Warnings collection
    match /studentWarnings/{warningId} {
      // Students can only read their own warnings
      allow read: if isStudent() && resource.data.studentId == request.auth.uid;
      // Teachers can only read warnings for their own assigned students
      // (Phase 2 Feature 6 audit finding — same gap as `results` above).
      allow read: if isTeacher() && isAssignedToStudent(resource.data.studentId);
      // Admins can read all warnings
      allow read: if isAdmin();
      // Only teachers and admins can create warnings
      allow create: if isTeacherOrAdmin() && request.resource.data.studentId != null;
      // Only teachers and admins can update warnings
      allow update: if isTeacherOrAdmin();
      // Only admins can delete warnings
      allow delete: if isAdmin();
    }

    // Result Notifications collection (for real-time update signaling).
    // Not currently written or read by any app code (confirmed unused,
    // Phase 2 Feature 6 audit), but `allow read: if isAuthenticated()` let
    // any signed-in student read every other student's signal — tightened
    // to staff-only in case this is wired up later.
    match /resultNotifications/{notificationId} {
      allow read: if isTeacherOrAdmin();
      allow create: if isTeacherOrAdmin();
      allow delete: if isAdmin();
    }

    // ============ Notice Module ============

    // Notices collection
    match /notices/{noticeId} {
      // Students can only read PUBLISHED notices that are actually addressed to
      // them AND whose teacher is one an admin actually assigned this student
      // to (Task 10 — teacher communication only reaches assigned students).
      // These conditions mirror the queries in getStudentNotices() — keep
      // the two in sync or student notice lists will fail with permission-denied.
      allow read: if isStudent() &&
                     resource.data.status == 'published' &&
                     resource.data.teacherId in getUserData().get('assignedTeacherIds', []) && (
                       resource.data.targetType == 'all' ||
                       (resource.data.targetType == 'individual' &&
                        request.auth.uid in resource.data.get('targetStudentIds', [])) ||
                       (resource.data.targetType in ['batch', 'semester'] &&
                        resource.data.get('targetBatch', '') == getUserData().get('batch', '')) ||
                       (resource.data.targetType == 'section' &&
                        resource.data.get('targetSection', '') == getUserData().get('section', '') &&
                        // Section names repeat across batches ("D1" exists in
                        // 232 and 241), so a section notice must also match the
                        // student's batch. Notices created before the batch
                        // selector existed have no targetBatch and stay
                        // section-only. Mirrored in getStudentNotices().
                        (resource.data.get('targetBatch', '') == '' ||
                         resource.data.get('targetBatch', '') == getUserData().get('batch', ''))) ||
                       (resource.data.targetType == 'course' &&
                        resource.data.get('targetCourseId', '') in getUserData().get('courses', []))
                     );
      // Teachers can read their own notices (draft or published)
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      // Admins can read all notices
      allow read: if isAdmin();
      // Teachers can create notices
      allow create: if isTeacher() && isActiveUser() &&
                       request.resource.data.teacherId == request.auth.uid &&
                       request.resource.data.status in ['draft', 'published'];
      // Teachers can update their own notices
      allow update: if isTeacher() && isActiveUser() && resource.data.teacherId == request.auth.uid;
      // Admins can update any notice
      allow update: if isAdmin();
      // Teachers can delete their own notices
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
      // Admins can delete any notice
      allow delete: if isAdmin();
    }

    // Notice Reads collection
    match /noticeReads/{readId} {
      // Students can read their own read status
      allow read: if isStudent() && resource.data.studentId == request.auth.uid;
      // Teachers can read read status for their notices
      allow read: if isTeacher();
      // Admins can read all
      allow read: if isAdmin();
      // Students can mark notices as read
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      // Staff clean these up when a notice is deleted (without this, deleting a
      // notice that anyone had read failed with permission-denied).
      allow delete: if isTeacherOrAdmin();
    }

// Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Staff can read them to report delivery and to clean up deleted notices
      allow read: if isTeacherOrAdmin();
      // Teachers and admins create notifications when publishing notices
      allow create: if isTeacherOrAdmin() &&
                       request.resource.data.type == 'notice' &&
                       request.resource.data.userId != null &&
                       request.resource.data.noticeId != null;
      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // Admin can manage
      allow update: if isAdmin();
      // Staff remove a notice's notifications when the notice is deleted.
      allow delete: if isTeacherOrAdmin();
    }

    // ============ Teacher Assignment Module ============

    // teacher_assignments collection
    match /teacher_assignments/{assignmentId} {
      // Teachers can read their own assignments
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      // Admins can read all assignments
      allow read: if isAdmin();
      // Only admins can create/update/delete assignments
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // teacher_student_mapping collection
    match /teacher_student_mapping/{mappingId} {
      // Teachers can read mappings where they are the teacher
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      // Admins can read all mappings
      allow read: if isAdmin();
      // Only admins can create/update/delete mappings
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============ Classroom Module (Phase 2, Feature 1) ============

    // `classroomId` is passed in rather than read here so the caller decides
    // whether it is reading it off `resource` or `request.resource`.
    //
    // The empty-string guard is load-bearing. A rule that dereferences a field
    // a document does not have RAISES, and a raise is a denial — so on a LIST
    // query (the comment/post/classwork streams are all live subscriptions) a
    // single legacy document without `classroomId` denied the entire query,
    // not just that one document. That is the `permission-denied` the comment
    // subscription was failing with. Callers now pass `.get('classroomId','')`,
    // and an empty id can never match a real membership document id.
    function isClassroomMember(classroomId) {
      return isAuthenticated() && classroomId != '' &&
        exists(/databases/$(database)/documents/classroomMembers/$(classroomId + '_' + request.auth.uid));
    }

    // A membership document id is always `${classroomId}_${studentId}`, so the
    // id alone identifies whose membership it is — no document read required.
    //
    // This exists because `resource` is NULL when the document does not exist,
    // and dereferencing null RAISES, which Firestore treats as a denial. The
    // "have I already joined?" check that runs before every join-by-code reads
    // exactly such a document, so it failed with permission-denied for every
    // student who had not joined yet — the "authorization error" students hit
    // on the join screen. Granting a read of an id that encodes the caller's
    // own uid discloses nothing they are not already entitled to see.
    function isOwnMembershipDocId(membershipId) {
      return isAuthenticated() && membershipId.matches('.*_' + request.auth.uid);
    }

    // Classrooms collection
    match /classrooms/{classroomId} {
      // Broad read: needed so a student can look up a classroom by code
      // before joining, and so "already joined" checks work. The classroom
      // doc itself (name/subject/code) is not sensitive; content (posts,
      // classwork, roster) is gated separately below.
      allow read: if isAuthenticated();
      allow create: if isTeacher() && isActiveUser() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow update, delete: if isAdmin();
      // A joining/leaving student must be able to move the roster counter by
      // exactly one. joinClassroomByCode/leaveClassroom commit the member doc
      // and this counter in a single atomic batch — without this branch the
      // WHOLE batch was rejected, which is why joining and leaving both
      // failed with a misleading "not allowed to join" error.
      allow update: if isStudent() && isActiveUser() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentCount', 'updatedAt']) &&
        request.resource.data.studentCount is int &&
        request.resource.data.studentCount >= 0 &&
        (request.resource.data.studentCount == resource.data.get('studentCount', 0) + 1 ||
         request.resource.data.studentCount == resource.data.get('studentCount', 0) - 1);
    }

    // Classroom membership ("People" tab / joined students). Document id is
    // deterministic `${classroomId}_${studentId}` — this both stops
    // duplicate joins (a second `create` on the same id is an `update`,
    // which this rule doesn't grant to students) and lets other collections
    // cheaply check "is this student a member" via exists().
    match /classroomMembers/{memberId} {
      // Staff, the member themself, or any fellow member of the same
      // classroom (so the People tab roster loads for students — previously
      // a student's roster query was denied outright and the tab silently
      // rendered "No students found").
      //
      // The `resource != null` guard is load-bearing for the same reason the
      // empty-string guard in isClassroomMember() is: a rule that dereferences
      // a null resource raises, and a raise is a denial.
      allow read: if isTeacherOrAdmin() ||
        isOwnMembershipDocId(memberId) ||
        (resource != null && (
          (isAuthenticated() && resource.data.studentId == request.auth.uid) ||
          isClassroomMember(resource.data.get('classroomId', ''))
        ));
      // Self-join by code: classroom membership is its own access boundary
      // now (no separate admin Course/Batch/Section assignment required —
      // see lib/firebase/classrooms.ts#joinClassroomByCode). The submitted
      // `teacherId` must match the classroom's real owner so the
      // denormalized field recomputeAssignedTeacherIds() relies on can't be
      // spoofed.
      allow create: if isStudent() && isActiveUser() &&
        request.resource.data.studentId == request.auth.uid &&
        memberId == request.resource.data.classroomId + '_' + request.auth.uid &&
        request.resource.data.teacherId == get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId &&
        get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.status == 'active';
      // Teacher-initiated add (manual, or Course/Batch/Section bulk-add) —
      // only the classroom's own teacher, or an admin, may add a student
      // this way.
      allow create: if (
          (isTeacher() && get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId == request.auth.uid) ||
          isAdmin()
        ) &&
        memberId == request.resource.data.classroomId + '_' + request.resource.data.studentId &&
        request.resource.data.teacherId == get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId &&
        get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.status == 'active';
      // Student leaves, or teacher/admin removes them.
      allow delete: if isTeacherOrAdmin() ||
        (isAuthenticated() && resource.data.studentId == request.auth.uid);
    }

    // Stream posts (announcements/notices/materials)
    match /classroomPosts/{postId} {
      allow read: if isTeacherOrAdmin() || isClassroomMember(resource.data.get('classroomId', ''));
      allow create: if isTeacher() && isActiveUser() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Stream comments
    match /classroomComments/{commentId} {
      allow read: if isTeacherOrAdmin() || isClassroomMember(resource.data.get('classroomId', ''));
      allow create: if isAuthenticated() && isActiveUser() &&
        request.resource.data.authorId == request.auth.uid &&
        (isTeacherOrAdmin() || isClassroomMember(request.resource.data.get('classroomId', '')));
      allow delete: if isTeacherOrAdmin() ||
        (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Classwork (assignments/quizzes/materials/resources/links)
    match /classroomClasswork/{itemId} {
      // Students only ever see published classwork; drafts are teacher-only.
      allow read: if isTeacherOrAdmin() ||
        (resource.data.get('status', '') == 'published' &&
         isClassroomMember(resource.data.get('classroomId', '')));
      allow create: if isTeacher() && isActiveUser() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Classwork submissions (student hand-in + teacher evaluation).
    //
    // Document id is deterministic `${classworkId}_${studentId}`, which is what
    // makes a duplicate submission impossible: a second `create` on the same id
    // is an `update`, and the update rules below only ever let a student touch
    // their OWN document.
    match /classroomSubmissions/{submissionId} {
      // The student it belongs to, the classroom's teacher, or an admin.
      // Students may not read each other's work — an assignment answer is
      // exactly as sensitive as an exam answer.
      //
      // The `resource == null` branch is load-bearing, and its absence was the
      // "insufficient permissions" students hit when handing in an assignment
      // for the FIRST time. `submitClasswork()` reads the submission document
      // before writing it (to refuse editing work that has already been
      // marked), and on a first hand-in that document does not exist yet.
      // Rules evaluate a missing document with `resource == null`, and
      // `resource.data.X` on null RAISES — which Firestore treats as a denial.
      // So the read failed for exactly the students who had never submitted.
      // The id is `${classworkId}_${studentId}`, so a caller probing their own
      // is identifiable from the id alone, with no document to read. Same fix
      // as examAttemptCounters above and classroomMembers below.
      allow read: if isAdmin() ||
        (isAuthenticated() && resource == null &&
         submissionId.matches('.*_' + request.auth.uid)) ||
        (resource != null && (
          (isAuthenticated() && resource.data.studentId == request.auth.uid) ||
          (isTeacher() && resource.data.teacherId == request.auth.uid)
        ));

      // Hand-in. The student must be a member of the classroom, must be
      // submitting as themselves, must use the deterministic id, and must
      // carry the classwork's REAL teacherId — the field the read and grading
      // rules above trust. Reading it off the classwork document rather than
      // the request is what stops a student naming any teacher they like.
      allow create: if isStudent() && isActiveUser() &&
        request.resource.data.studentId == request.auth.uid &&
        submissionId == request.resource.data.classworkId + '_' + request.auth.uid &&
        isClassroomMember(request.resource.data.get('classroomId', '')) &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.teacherId ==
          get(/databases/$(database)/documents/classroomClasswork/$(request.resource.data.classworkId)).data.teacherId &&
        get(/databases/$(database)/documents/classroomClasswork/$(request.resource.data.classworkId)).data.status == 'published' &&
        // Grading fields are the teacher's alone. Without this a student could
        // submit their own work pre-marked.
        !request.resource.data.keys().hasAny([
          'marks', 'feedback', 'gradedBy', 'gradedByName', 'gradedAt',
          'aiSuggestedMarks', 'aiRationale'
        ]);

      // Revising before it is marked. The allowlist is what keeps `marks`,
      // `status`, and `late` out of the student's reach — `late` in particular
      // is resolved once at hand-in and must not be editable afterwards.
      allow update: if isStudent() && isActiveUser() &&
        resource.data.studentId == request.auth.uid &&
        resource.data.status != 'returned' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text', 'attachments', 'updatedAt', 'submittedAt'
        ]);

      // Withdrawing work that has not been marked yet.
      allow delete: if isAdmin() ||
        (isStudent() && resource.data.studentId == request.auth.uid &&
         resource.data.status != 'returned');

      // Evaluation — marks, feedback, returning, and the machine-assisted
      // pre-pass. Scoped to the classwork's own teacher, not any teacher.
      allow update: if isAdmin() ||
        (isTeacher() && isActiveUser() && resource.data.teacherId == request.auth.uid);
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // Email delivery log for classroom notifications — written by the
    // server (Admin SDK, /api/classroom/notify) which bypasses rules;
    // these rules only cover the (currently unused) direct-client path.
    match /classroomEmailLogs/{logId} {
      allow read: if isTeacherOrAdmin();
      allow create: if isTeacherOrAdmin();
    }

    // =====================================================================
    // GREEN ROOM (live classroom / video meetings)
    //
    // Split of responsibility, deliberately:
    //   - Everything that grants AUTHORITY (meeting role, admission state,
    //     attendance timings, meeting lifecycle) is written ONLY by the
    //     Admin SDK through /api/greenroom/*, which bypasses these rules.
    //     Clients are denied those writes here, so a participant cannot
    //     promote themselves or fake attendance by PATCHing Firestore.
    //   - Everything that is merely SELF-REPORTED presence (my mic is on, my
    //     hand is up) is client-writable on the participant's OWN document,
    //     via a field allowlist — the same pattern used by examSessions.
    // =====================================================================

    // Is the caller a joined/admitted participant of this meeting? Used to
    // scope reads of chat, reactions and the roster to people actually in
    // the room, rather than any authenticated user who knows a meeting id.
    function isMeetingParticipant(meetingId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/greenRoomParticipants/$(meetingId + '_' + request.auth.uid));
    }

    // The meeting's owning teacher. Reads the meeting doc, so only call it
    // where a meeting id is already in hand.
    function isMeetingOwner(meetingId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/greenRoomMeetings/$(meetingId)).data.teacherId == request.auth.uid;
    }

    match /greenRoomMeetings/{meetingId} {
      // Broad authenticated read: a student needs to resolve a meeting by
      // code on the pre-join screen before any participant document exists
      // for them. The document carries no secret — the passcode lives in
      // greenRoomSecrets, which no client may read at all.
      allow read: if isAuthenticated();

      // All writes go through /api/greenroom/* (Admin SDK). Creating a
      // meeting client-side would let a student mint one with themselves as
      // teacher, and updating one would let a participant flip `locked` or
      // `settings` without being a host.
      allow create, update, delete: if false;
    }

    // Passcode hashes. No client access whatsoever, in either direction —
    // this is the whole reason the passcode is not a field on the meeting.
    match /greenRoomSecrets/{meetingId} {
      allow read, write: if false;
    }

    match /greenRoomParticipants/{participantId} {
      // Staff and fellow participants can see the roster (names, mic/cam
      // state) — that is what the Participants panel renders.
      allow read: if isTeacherOrAdmin() ||
        (resource != null && (
          resource.data.userId == request.auth.uid ||
          isMeetingParticipant(resource.data.get('meetingId', ''))
        ));
      // Probing your own (not yet existing) participant doc must not raise.
      allow read: if isAuthenticated() && isMissingDoc();

      // Admission, role and attendance are server-assigned: /api/greenroom/join
      // creates the document and /api/greenroom/moderate changes authority.
      allow create, delete: if false;

      // Self-reported presence only, on your own document. `role`, `state`,
      // `userId`, `meetingId` and every attendance field are absent from this
      // allowlist, so a participant cannot promote themselves to host, admit
      // themselves past the waiting room, or inflate their attended time.
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'micOn', 'camOn', 'handRaised', 'screenSharing', 'lastSeenAt', 'updatedAt'
        ]);
    }

    // WebRTC signalling (SDP offers/answers and ICE candidates) for the mesh.
    // Scoped to participants of the meeting: these blobs are useless without
    // the peer, but there is no reason to expose them room-wide either.
    match /greenRoomSignals/{meetingId} {
      allow read, write: if isMeetingParticipant(meetingId);

      match /peers/{peerId} {
        allow read, write: if isMeetingParticipant(meetingId);
      }
    }

    match /greenRoomMessages/{messageId} {
      allow read: if isTeacherOrAdmin() ||
        (resource != null && isMeetingParticipant(resource.data.get('meetingId', '')));

      // Send as yourself, into a meeting you are actually in. Whether chat is
      // *permitted* (settings.allowChat) is enforced in the client and by the
      // host's ability to moderate — rules cannot cheaply read meeting
      // settings on every message write.
      allow create: if isAuthenticated() && isActiveUser() &&
        request.resource.data.senderId == request.auth.uid &&
        isMeetingParticipant(request.resource.data.get('meetingId', '')) &&
        request.resource.data.get('type', 'chat') == 'chat';

      // Chat is an attendance/conduct record: authors may not rewrite history.
      allow update: if false;
      allow delete: if isAdmin() || isMeetingOwner(resource.data.get('meetingId', ''));
    }

    match /greenRoomReactions/{reactionId} {
      allow read: if isTeacherOrAdmin() ||
        (resource != null && isMeetingParticipant(resource.data.get('meetingId', '')));
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        isMeetingParticipant(request.resource.data.get('meetingId', ''));
      allow update: if false;
      // Reactions are ephemeral; the sender or the host may clear them.
      allow delete: if isAdmin() ||
        (resource != null && resource.data.senderId == request.auth.uid) ||
        isMeetingOwner(resource.data.get('meetingId', ''));
    }
  }
}
