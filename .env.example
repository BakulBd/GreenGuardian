# ============================================================
# GreenGuardian — Environment Variables
# Copy this file to `.env.local` (or your platform's env config)
# and fill in real values. Never commit secrets.
# ============================================================

# ----- Firebase Web (client SDK) -----
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=greenguardian2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=greenguardian2026
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ----- Backblaze B2 object storage (server-only, REQUIRED for uploads) -----
# All file uploads (exam papers, answers, classroom materials, avatars,
# proctoring evidence) live in a PRIVATE B2 bucket. These are real credentials
# — never prefix them with NEXT_PUBLIC_, which would inline them in the browser
# bundle and hand anyone full read/write on the bucket.
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-bucket-name
# Optional. Signs the durable /api/storage/download links stored in Firestore.
# Falls back to B2_APPLICATION_KEY, which means rotating that key invalidates
# every existing attachment link — set this in production to decouple them.
# STORAGE_URL_SECRET=
# Optional. Overrides the origins written by `npm run storage:cors`.
# B2_CORS_ORIGINS=https://your-domain.com,http://localhost:3000

# ----- Firebase Admin SDK (server-only) -----
# Option A: inline JSON service account (one line, escaped)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Option B: path to a service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ----- SMTP (email delivery for OTP) -----
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM="GreenGuardian <no-reply@yourdomain.com>"

# ----- Registration security -----
# Strong key used to AES-256-GCM encrypt pending passwords at rest.
# Use a random 32+ character string, e.g.:
#   openssl rand -hex 32  -> 64 hex chars
REGISTRATION_ENC_KEY=replace-with-a-strong-random-key-at-least-32-chars

# ----- Optional: Firebase emulators (local dev) -----
# USE_FIREBASE_EMULATOR=true

