# ============================================================
# GreenGuardian - Email Verification (OTP) server configuration
# ============================================================
# Copy this file to `.env.local` and fill in the values.
#
# NOTE: `.env.local` is gitignored — never commit real secrets.

# ------------------------------------------------------------------
# 1) Firebase Admin SDK credentials (REQUIRED)
# ------------------------------------------------------------------
# The server-side API routes (register / verify-otp / resend-otp) use the
# Firebase Admin SDK to look up existing users and to CREATE the account AFTER
# the OTP is verified. Without credentials the registration API cannot work.
#
# Choose ONE of the following:

# Option A: Inline JSON service account (single line)
#   Firebase Console -> Project settings -> Service accounts -> Generate new private key
#   Paste the full JSON as a single line, escaped.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"greenguardian2026",...}

# Option B: serviceAccountKey.json in project root
#   Place the downloaded service account JSON at ./serviceAccountKey.json
#   (already gitignored). No env var needed.

# Option C: GOOGLE_APPLICATION_CREDENTIALS path
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccountKey.json

# ------------------------------------------------------------------
# 2) Registration encryption key (REQUIRED)
# ------------------------------------------------------------------
# Used to AES-256-GCM encrypt the temporary password stored in the
# pendingRegistrations collection until the OTP is verified.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REGISTRATION_ENC_KEY=

# ------------------------------------------------------------------
# 3) SMTP (for real email delivery)
# ------------------------------------------------------------------
# Without SMTP the OTP is only printed to the server console (dev mode),
# which is fine for local testing but not for production.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# MAIL_FROM="GreenGuardian <you@example.com>"

# ------------------------------------------------------------------
# 4) Optional: local emulator (development only)
# ------------------------------------------------------------------
# Run `npm run emulators` and set BOTH of these to use the Firebase emulators.
# The NEXT_PUBLIC_ one is required for the browser SDK (a bare server variable is
# undefined in the client bundle); the plain one is used by the Admin SDK.
# In emulator mode the Admin SDK does NOT need a service account.
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# USE_FIREBASE_EMULATOR=true

# ------------------------------------------------------------------
# 5) Gemini AI & Vision OCR API Key
# ------------------------------------------------------------------
# SERVER-SIDE ONLY. Never use a NEXT_PUBLIC_ prefix for this key: that inlines it
# into the browser bundle where anyone can extract it and spend your quota.
# Browser code calls /api/ocr, which holds the key and verifies the caller's
# Firebase ID token.
GEMINI_API_KEY=

# ------------------------------------------------------------------
# 6) Live exam video (teacher "Watch Live" monitoring) — OPTIONAL
# ------------------------------------------------------------------
# Live video needs NO server of its own: it uses browser-to-browser WebRTC and
# falls back to a Firestore frame relay, so it works on Vercel exactly like it
# does on localhost.
#
# STUN alone cannot punch through symmetric NATs / strict campus firewalls
# (roughly 10-20% of real connections). Those students automatically drop to the
# Firestore relay (~1 frame/sec). To give them full-rate P2P video instead,
# point these at a TURN server (e.g. Metered, Twilio, Cloudflare Calls, or a
# self-hosted coturn):
#
# NEXT_PUBLIC_TURN_URLS=turn:your-turn-host:3478,turns:your-turn-host:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# ------------------------------------------------------------------
# 7) Diagnostics endpoint token (production only)
# ------------------------------------------------------------------
# /api/auth/config-check reports which server config is present. In production
# it returns 404 unless this token is supplied via the x-config-check-token
# header or a ?token= query parameter. Leave unset to keep it disabled in prod.
# CONFIG_CHECK_TOKEN=
