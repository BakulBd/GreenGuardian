[debug] [2026-08-10T12:31:19.177Z] <<< [apiv2][status] POST https://firebaserules.googleapis.com/v1/projects/greenguardian2026/rulesets 200
[debug] [2026-08-10T12:31:19.179Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/greenguardian2026/rulesets {"name":"projects/greenguardian2026/rulesets/466c37ed-6570-4381-a2e9-13dc4fb4a5fa","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // Helper functions\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n    \n    function isUser(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n    \n    function getUserData() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\n    }\n    \n    function isAdmin() {\n      return isAuthenticated() && getUserData().role == 'admin';\n    }\n    \n    function isTeacher() {\n      return isAuthenticated() && getUserData().role == 'teacher';\n    }\n    \n    function isStudent() {\n      return isAuthenticated() && getUserData().role == 'student';\n    }\n    \n    function isTeacherOrAdmin() {\n      return isAdmin() || isTeacher();\n    }\n\n    // Accounts an admin has put on hold or suspended may not perform actions\n    // (start/submit exams, create content). Missing `status` == active.\n    function isActiveUser() {\n      return isAuthenticated() && getUserData().get('status', 'active') == 'active';\n    }\n\n    // Deterministic per-student-per-exam attempt counter document ID,\n    // shared by the examAttemptCounters rules and the examSessions create\n    // rule below (Task 4 — exam attempt limits).\n    function attemptCounterId(examId, studentId) {\n      return examId + '_' + studentId;\n    }\n\n    /**\n     * True when the requested document does not exist.\n     *\n     * A document that is not there discloses nothing, but a rule that reaches\n     * for `resource.data.X` on a missing document RAISES, and a raise is a\n     * denial. Every \"does this exist?\" probe therefore fails as\n     * permission-denied unless a rule says otherwise — which is a bug that has\n     * now been found four separate times in this project (first attempt at an\n     * exam, first classroom join, first assignment hand-in, and opening a\n     * result by session id). Collections whose ids clients legitimately probe\n     * carry an explicit branch for it.\n     */\n    function isMissingDoc() {\n      return resource == null;\n    }\n\n    // Is the requesting teacher one this student is actually assigned to?\n    // (Phase 2 Feature 6.) Looks up the STUDENT's own assignedTeacherIds\n    // rather than requiring a denormalized teacher->students list — reuses\n    // the same field Task 10 already maintains.\n    function isAssignedToStudent(studentId) {\n      return isAuthenticated() &&\n        request.auth.uid in get(/databases/$(database)/documents/users/$(studentId)).data.get('assignedTeacherIds', []);\n    }\n    \n    // Users collection\n    match /users/{userId} {\n      // Authenticated users (students, teachers, admins) can read user profiles\n      allow read: if isAuthenticated();\n      \n      // Users can only create their own document during registration\n      allow create: if isUser(userId) && \n                      request.resource.data.id == userId &&\n                      request.resource.data.email == request.auth.token.email &&\n                      request.resource.data.role in ['student', 'teacher'] &&\n                      (!request.resource.data.keys().hasAny(['approved']) || \n                       request.resource.data.role == 'student' && request.resource.data.approved == true ||\n                       request.resource.data.role == 'teacher' && request.resource.data.approved == false);\n      \n      // Users can update their own profile — name, phone, avatar, and the\n      // mustChangePassword acknowledgement. Everything that decides ACCESS is\n      // excluded and stays server/admin-owned:\n      //\n      //   role, approved, rejected, id, status\n      //     — identity and account state.\n      //   assignedTeacherIds\n      //     — the field the notice and exam rules trust to decide whose content\n      //       a student may read. Self-writable, it would let any student grant\n      //       themselves another teacher's communications. Written only by the\n      //       Admin SDK (lib/server/roster.ts, /api/classroom/sync-access).\n      //   batch, section, sections, studentCode, department\n      //     — academic placement. This is the INPUT the roster is derived from,\n      //       so leaving it self-writable is the same hole one step removed: a\n      //       student could move into any section and pick up that section's\n      //       exams and notices on the next roster sync. Changed by an admin\n      //       via the Students page, which resyncs the roster with it.\n      allow update: if isUser(userId) &&\n                       !request.resource.data.diff(resource.data).affectedKeys().hasAny([\n                         'role', 'approved', 'rejected', 'id', 'status',\n                         'assignedTeacherIds',\n                         'batch', 'section', 'sections', 'studentCode', 'department'\n                       ]);\n      \n      // Admins can update any user (for approval/rejection)\n      allow update: if isAdmin();\n      \n      // Only admins can delete users\n      allow delete: if isAdmin();\n    }\n    \n    // Pending Registrations collection (email-verification flow)\n    // This collection is written ONLY by the Firebase Admin SDK (server-side\n    // API routes) using server credentials, which bypass security rules.\n    // Clients must never read or write these sensitive records.\n    match /pendingRegistrations/{registrationId} {\n      allow read, write: if false;\n    }\n    \n    // Batch-wise student ID sequences (lib/server/student-ids.ts).\n    //\n    // Written ONLY by the Admin SDK, which bypasses these rules. Client access\n    // is denied outright: a client that could write a counter could rewind it\n    // and mint a duplicate student ID, and one that could only read it still\n    // learns the exact size of every batch for nothing in return.\n    match /studentCodeCounters/{counterId} {\n      allow read, write: if false;\n    }\n\n    // Exams collection\n    match /exams/{examId} {\n      // Teachers can read their own exams (any status).\n      allow read: if isTeacher() && (resource.data.teacherId == request.auth.uid || resource.data.createdBy == request.auth.uid);\n      // Admins can read any exam.\n      allow read: if isAdmin();\n      // Students can only read an exam they were specifically targeted for —\n      // `targetStudentIds` is resolved at creation time from the teacher's\n      // Course+Batch+Section assignment (see computeAssignmentTargetStudentIds\n      // in lib/firebase/assignments.ts). Exams created before this field\n      // existed stay invisible until an admin runs the one-time\n      // backfillExamTargetStudentIds() — same fail-closed-until-backfilled\n      // tradeoff already used for `assignedTeacherIds`.\n      //\n      // `completed`/`archived` are included deliberately: a student must be\n      // able to re-open /exam/{id}/review after the teacher closes the exam,\n      // and ExamClient re-reads the exam doc while grading a submission. The\n      // listing query (subscribeToStudentVisibleExams) filters to\n      // published/active itself, so a closed exam still never appears as\n      // startable — this only keeps already-earned results readable.\n      allow read: if isStudent() &&\n                     resource.data.status in ['published', 'active', 'completed', 'archived'] &&\n                     request.auth.uid in resource.data.get('targetStudentIds', []);\n\n      // Teachers can create exams\n      allow create: if isTeacher() && isActiveUser() &&\n                       request.resource.data.teacherId == request.auth.uid &&\n                       request.resource.data.status in ['draft', 'published'];\n\n      // Teachers can update their own exams\n      allow update: if isTeacher() && isActiveUser() && (resource.data.teacherId == request.auth.uid || resource.data.createdBy == request.auth.uid);\n      \n      // Admins can update/delete any exam\n      allow update, delete: if isAdmin();\n      \n      // Teachers can delete their own exams\n      allow delete: if isTeacher() && (resource.data.teacherId == request.auth.uid || resource.data.createdBy == request.auth.uid);\n    }\n    \n    // Questions collection\n    match /questions/{questionId} {\n      // Staff can read any question (needed by the exam builder/review UIs).\n      //\n      // Students get NO read access here at all. Question documents carry\n      // `correctAnswer`, and no rule can hand a student the question text\n      // without also handing them the key. Their paper is served instead by\n      // `/api/exams/paper`, which strips the key server-side, and their\n      // submission is graded by `/api/exams/grade`, which reads this\n      // collection with the Admin SDK. After submitting, the answer key\n      // reaches the student through `answers/{id}.questionSnapshot` — written\n      // by the grading route, once the attempt is over.\n      allow read: if isTeacherOrAdmin();\n\n      // Teachers can create questions for their exams\n      allow create: if isTeacher() && \n                       exists(/databases/$(database)/documents/exams/$(request.resource.data.examId)) &&\n                       get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.teacherId == request.auth.uid;\n      \n      // Teachers can update/delete questions for their exams\n      allow update, delete: if isTeacher() && \n                               exists(/databases/$(database)/documents/exams/$(resource.data.examId)) &&\n                               get(/databases/$(database)/documents/exams/$(resource.data.examId)).data.teacherId == request.auth.uid;\n      \n      // Admins can do everything\n      allow update, delete: if isAdmin();\n    }\n    \n    // Exam Sessions collection\n    match /examSessions/{sessionId} {\n      // `getResultDetails()` probes results/{id} and then examSessions/{id}\n      // with the same id, so one of the two is always a miss by design.\n      allow read: if isAuthenticated() && isMissingDoc();\n\n      // Students can read their own sessions\n      allow read: if !isMissingDoc() && isUser(resource.data.studentId);\n\n      // Teachers and admins can read sessions for monitoring and evaluation\n      allow read: if isTeacherOrAdmin();\n      \n      // Students can create their own sessions. attemptNumber must be a\n      // positive integer within the exam's attemptsAllowed cap, and must\n      // equal (pre-write counter value + 1) / 1 if no counter exists yet.\n      // The client writes the matching examAttemptCounters update in the\n      // same transaction (see ExamClient.startExam) — since rule `get()`\n      // calls inside a transaction see the pre-transaction snapshot, this\n      // is safe against a crafted client trying to skip the counter or\n      // claim an attempt number a real transaction wouldn't produce.\n      allow create: if isAuthenticated() && isActiveUser() &&\n               request.resource.data.studentId == request.auth.uid &&\n               exists(/databases/$(database)/documents/exams/$(request.resource.data.examId)) &&\n               request.resource.data.attemptNumber is int &&\n               request.resource.data.attemptNumber >= 1 &&\n               request.resource.data.attemptNumber <=\n                 get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.get('attemptsAllowed', 1) &&\n               request.resource.data.attemptNumber == (\n                 exists(/databases/$(database)/documents/examAttemptCounters/$(attemptCounterId(request.resource.data.examId, request.auth.uid)))\n                   ? get(/databases/$(database)/documents/examAttemptCounters/$(attemptCounterId(request.resource.data.examId, request.auth.uid))).data.count + 1\n                   : 1\n               );\n\n      // Students can update their own sessions, but only the fields their own\n      // browser is the source of: autosaved answers, the proctoring counters\n      // its sensors produce, and the lifecycle transitions it drives\n      // (resume, and closing out an attempt whose time expired offline).\n      //\n      // Every scoring field is excluded. `score`, `totalMarks`, `accuracy`,\n      // `correctAnswers`, `wrongAnswers`, `grading`, `flagged`, … are written\n      // ONLY by /api/exams/grade through the Admin SDK. Until this allowlist\n      // existed, a student could PATCH their own session with `score: 100`:\n      // grading ran in their browser, so the rules had no way to tell a real\n      // score from an invented one, and simply trusted whatever arrived.\n      allow update: if isUser(resource.data.studentId) && isActiveUser() &&\n                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n                         'savedAnswers', 'updatedAt', 'status', 'submitted',\n                         'completedAt', 'reason', 'resumedAt',\n                         'warnings', 'behaviorScore', 'violationCounts', 'proctoring'\n                       ]);\n\n      // Teachers and admins can update sessions for monitoring\n      allow update: if isTeacherOrAdmin() && isActiveUser();\n    }\n\n    // Exam attempt counters — one document per (exam, student) pair,\n    // backing the attempt-limit enforcement above (Task 4).\n    match /examAttemptCounters/{counterId} {\n      // `resource == null` short-circuits before dereferencing `.data` — a\n      // student's first attempt at any exam reads this doc before it exists\n      // (see ExamClient.startExam's transaction), and resource.data.X on a\n      // nonexistent doc throws in rules, which is treated as a denial. That\n      // was silently blocking every first attempt.\n      allow read: if isTeacherOrAdmin() ||\n        (isAuthenticated() && (resource == null || resource.data.studentId == request.auth.uid));\n      allow create: if isAuthenticated() && isActiveUser() &&\n        request.resource.data.studentId == request.auth.uid &&\n        request.resource.data.count == 1;\n      allow update: if isAuthenticated() && isActiveUser() &&\n        resource.data.studentId == request.auth.uid &&\n        request.resource.data.count == resource.data.count + 1;\n    }\n\n    // Answers collection\n    match /answers/{answerId} {\n      // Students can read their own answers\n      allow read: if isUser(resource.data.studentId);\n      \n      // Teachers and admins can read answers\n      allow read: if isTeacherOrAdmin();\n      \n      // Submissions are CREATED server-side only (/api/exams/grade, Admin SDK,\n      // which bypasses these rules). A student-created answer document was how\n      // a submission used to arrive, carrying a browser-computed `score` that\n      // nothing could verify — the document and its grade are now written\n      // together by the server from the answer key.\n      //\n      // The one thing a student still writes here is the result of the\n      // background OCR pass on their own upload-mode submission, which runs in\n      // their browser after submitting.\n      allow update: if isAuthenticated() && isActiveUser() &&\n               resource.data.studentId == request.auth.uid &&\n               request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n                 'ocrAnalysis', 'ocrText', 'ocrStatus'\n               ]);\n\n      // Teachers and admins can update answers (for grading, OCR analysis & similarity reports)\n      allow update: if isTeacherOrAdmin() && isActiveUser();\n    }\n\n    // Similarity Reports collection\n    //\n    // Written exclusively by /api/plagiarism/check via the Admin SDK. Client\n    // writes are denied outright: this collection holds the verdict on whether\n    // a student plagiarised, and `allow create, update: if isAuthenticated()`\n    // let the accused student overwrite it with a clean score.\n    //\n    // Reads are STAFF-ONLY, including for the student the report is about: the\n    // `matches` array names the classmates whose answers theirs resembled and\n    // by how much. The student sees only their own verdict, via\n    // `similarityScore`/`similarityLevel` on their answer document.\n    match /similarityReports/{reportId} {\n      allow read: if isTeacherOrAdmin();\n      allow write: if false;\n    }\n\n    // ============ Live Exam Video (see lib/services/liveVideo.ts) ============\n\n    // WebRTC signaling: the student publishes offers/ICE, each watching teacher\n    // registers a presence document under `viewers` and answers there.\n    match /liveVideoSignaling/{sessionId} {\n      allow read: if isAuthenticated();\n      // Only the broadcasting student (or staff) may own the room document.\n      allow create, update: if isTeacherOrAdmin() ||\n        (isAuthenticated() && request.resource.data.studentId == request.auth.uid);\n      allow delete: if isTeacherOrAdmin() ||\n        (isAuthenticated() && resource.data.studentId == request.auth.uid);\n\n      match /viewers/{viewerId}/{allPaths=**} {\n        // Signaling payloads are ephemeral SDP/ICE blobs; both peers need\n        // read/write access to complete the handshake.\n        allow read, write: if isAuthenticated();\n      }\n    }\n\n    // Firestore frame relay — the transport that makes live video work without\n    // a VPS/TURN server. Written by the student, read by teachers/admins.\n    match /liveFrames/{sessionId} {\n      allow read: if isTeacherOrAdmin() ||\n        (isAuthenticated() && resource.data.studentId == request.auth.uid);\n      allow create, update: if isAuthenticated() &&\n        request.resource.data.studentId == request.auth.uid;\n      allow delete: if isTeacherOrAdmin() ||\n        (isAuthenticated() && resource.data.studentId == request.auth.uid);\n    }\n    \n    // Exam Logs collection\n    match /examLogs/{logId} {\n      allow read: if isAuthenticated();\n      allow create: if isAuthenticated();\n    }\n\n    // Proctoring Events collection\n    // Proctoring evidence (events, webcam snapshots, warning screenshots).\n    //\n    // Students WRITE these from the exam client but never read them back; only\n    // the teacher invigilation surfaces do. Read used to be `isAuthenticated()`,\n    // which let any signed-in student pull every other student's webcam\n    // captures and violation history straight out of Firestore.\n    // Own-session reads stay allowed so a student can still see their own\n    // record if a future screen needs it.\n    match /proctoringEvents/{eventId} {\n      allow read: if isTeacherOrAdmin() || isUser(resource.data.studentId);\n      allow create: if isAuthenticated();\n    }\n\n    // Proctoring Snapshots collection\n    match /proctoringSnapshots/{snapshotId} {\n      allow read: if isTeacherOrAdmin() || isUser(resource.data.studentId);\n      allow create: if isAuthenticated();\n    }\n\n    // Warning Screenshots collection — permanent proctoring evidence\n    // captured on every warning (Task 9's Snapshots gallery).\n    match /warningScreenshots/{screenshotId} {\n      allow read: if isTeacherOrAdmin() || isUser(resource.data.studentId);\n      allow create: if isAuthenticated();\n      allow delete: if isTeacherOrAdmin();\n    }\n\n    // Settings collection (admin only)\n    match /settings/{settingId} {\n      allow read: if isAuthenticated();\n      allow write: if isAdmin();\n    }\n\n    // ============ Course / Batch / Section Management ============\n\n    // Courses collection\n    match /courses/{courseId} {\n      // Any authenticated user can read courses (needed for forms across teacher/student panels)\n      allow read: if isAuthenticated();\n      // Only admins can create/update/delete courses\n      allow create: if isAdmin();\n      allow update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // Batches collection\n    match /batches/{batchId} {\n      // Any authenticated user can read batches\n      allow read: if isAuthenticated();\n      // Only admins can create/update/delete batches\n      allow create: if isAdmin();\n      allow update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // Sections collection\n    match /sections/{sectionId} {\n      // Any authenticated user can read sections\n      allow read: if isAuthenticated();\n      // Only admins can create/update/delete sections\n      allow create: if isAdmin();\n      allow update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n    \n    // Teacher Applications collection (optional)\n    match /teacherApplications/{applicationId} {\n      allow read: if isAdmin() || isUser(resource.data.userId);\n      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;\n      allow update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ============ Results Module ============\n\n    // Results collection\n    match /results/{resultId} {\n      // A student opening a result by exam-session id lands here first and\n      // misses; without this branch the miss was a permission error, the\n      // caller's catch swallowed it, and the examSessions fallback that would\n      // have rendered the result never ran. See getResultDetails().\n      allow read: if isAuthenticated() && isMissingDoc();\n\n      // Students can only read their own published results\n      allow read: if !isMissingDoc() && isStudent() &&\n        resource.data.studentId == request.auth.uid && resource.data.isPublished == true;\n      // Teachers can only read results for their own assigned students —\n      // the comment here used to claim \"via batch/section filtering\" but no\n      // such check actually existed, letting any teacher read any student's\n      // results (Phase 2 Feature 6 audit finding).\n      allow read: if !isMissingDoc() && isTeacher() && isAssignedToStudent(resource.data.studentId);\n      // Admins can read all results\n      allow read: if isAdmin();\n      // Only teachers and admins can create results\n      allow create: if isTeacherOrAdmin() && request.resource.data.studentId != null;\n      // Only teachers and admins can update results\n      allow update: if isTeacherOrAdmin();\n      // Only admins can delete results\n      allow delete: if isAdmin();\n    }\n\n    // Student Warnings collection\n    match /studentWarnings/{warningId} {\n      // Students can only read their own warnings\n      allow read: if isStudent() && resource.data.studentId == request.auth.uid;\n      // Teachers can only read warnings for their own assigned students\n      // (Phase 2 Feature 6 audit finding — same gap as `results` above).\n      allow read: if isTeacher() && isAssignedToStudent(resource.data.studentId);\n      // Admins can read all warnings\n      allow read: if isAdmin();\n      // Only teachers and admins can create warnings\n      allow create: if isTeacherOrAdmin() && request.resource.data.studentId != null;\n      // Only teachers and admins can update warnings\n      allow update: if isTeacherOrAdmin();\n      // Only admins can delete warnings\n      allow delete: if isAdmin();\n    }\n\n    // Result Notifications collection (for real-time update signaling).\n    // Not currently written or read by any app code (confirmed unused,\n    // Phase 2 Feature 6 audit), but `allow read: if isAuthenticated()` let\n    // any signed-in student read every other student's signal — tightened\n    // to staff-only in case this is wired up later.\n    match /resultNotifications/{notificationId} {\n      allow read: if isTeacherOrAdmin();\n      allow create: if isTeacherOrAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ============ Notice Module ============\n\n    // Notices collection\n    match /notices/{noticeId} {\n      // Students can only read PUBLISHED notices that are actually addressed to\n      // them AND whose teacher is one an admin actually assigned this student\n      // to (Task 10 — teacher communication only reaches assigned students).\n      // These conditions mirror the queries in getStudentNotices() — keep\n      // the two in sync or student notice lists will fail with permission-denied.\n      allow read: if isStudent() &&\n                     resource.data.status == 'published' &&\n                     resource.data.teacherId in getUserData().get('assignedTeacherIds', []) && (\n                       resource.data.targetType == 'all' ||\n                       (resource.data.targetType == 'individual' &&\n                        request.auth.uid in resource.data.get('targetStudentIds', [])) ||\n                       (resource.data.targetType in ['batch', 'semester'] &&\n                        resource.data.get('targetBatch', '') == getUserData().get('batch', '')) ||\n                       (resource.data.targetType == 'section' &&\n                        resource.data.get('targetSection', '') == getUserData().get('section', '') &&\n                        // Section names repeat across batches (\"D1\" exists in\n                        // 232 and 241), so a section notice must also match the\n                        // student's batch. Notices created before the batch\n                        // selector existed have no targetBatch and stay\n                        // section-only. Mirrored in getStudentNotices().\n                        (resource.data.get('targetBatch', '') == '' ||\n                         resource.data.get('targetBatch', '') == getUserData().get('batch', ''))) ||\n                       (resource.data.targetType == 'course' &&\n                        resource.data.get('targetCourseId', '') in getUserData().get('courses', []))\n                     );\n      // Teachers can read their own notices (draft or published)\n      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;\n      // Admins can read all notices\n      allow read: if isAdmin();\n      // Teachers can create notices\n      allow create: if isTeacher() && isActiveUser() &&\n                       request.resource.data.teacherId == request.auth.uid &&\n                       request.resource.data.status in ['draft', 'published'];\n      // Teachers can update their own notices\n      allow update: if isTeacher() && isActiveUser() && resource.data.teacherId == request.auth.uid;\n      // Admins can update any notice\n      allow update: if isAdmin();\n      // Teachers can delete their own notices\n      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;\n      // Admins can delete any notice\n      allow delete: if isAdmin();\n    }\n\n    // Notice Reads collection\n    match /noticeReads/{readId} {\n      // Students can read their own read status\n      allow read: if isStudent() && resource.data.studentId == request.auth.uid;\n      // Teachers can read read status for their notices\n      allow read: if isTeacher();\n      // Admins can read all\n      allow read: if isAdmin();\n      // Students can mark notices as read\n      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;\n      // Staff clean these up when a notice is deleted (without this, deleting a\n      // notice that anyone had read failed with permission-denied).\n      allow delete: if isTeacherOrAdmin();\n    }\n\n// Notifications collection\n    match /notifications/{notificationId} {\n      // Users can read their own notifications\n      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;\n      // Staff can read them to report delivery and to clean up deleted notices\n      allow read: if isTeacherOrAdmin();\n      // Teachers and admins create notifications when publishing notices\n      allow create: if isTeacherOrAdmin() &&\n                       request.resource.data.type == 'notice' &&\n                       request.resource.data.userId != null &&\n                       request.resource.data.noticeId != null;\n      // Users can update their own notifications (mark as read)\n      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&\n                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);\n      // Admin can manage\n      allow update: if isAdmin();\n      // Staff remove a notice's notifications when the notice is deleted.\n      allow delete: if isTeacherOrAdmin();\n    }\n\n    // ============ Teacher Assignment Module ============\n\n    // teacher_assignments collection\n    match /teacher_assignments/{assignmentId} {\n      // Teachers can read their own assignments\n      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;\n      // Admins can read all assignments\n      allow read: if isAdmin();\n      // Only admins can create/update/delete assignments\n      allow create: if isAdmin();\n      allow update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // teacher_student_mapping collection\n    match /teacher_student_mapping/{mappingId} {\n      // Teachers can read mappings where they are the teacher\n      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;\n      // Admins can read all mappings\n      allow read: if isAdmin();\n      // Only admins can create/update/delete mappings\n      allow create: if isAdmin();\n      allow update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ============ Classroom Module (Phase 2, Feature 1) ============\n\n    // `classroomId` is passed in rather than read here so the caller decides\n    // whether it is reading it off `resource` or `request.resource`.\n    //\n    // The empty-string guard is load-bearing. A rule that dereferences a field\n    // a document does not have RAISES, and a raise is a denial — so on a LIST\n    // query (the comment/post/classwork streams are all live subscriptions) a\n    // single legacy document without `classroomId` denied the entire query,\n    // not just that one document. That is the `permission-denied` the comment\n    // subscription was failing with. Callers now pass `.get('classroomId','')`,\n    // and an empty id can never match a real membership document id.\n    function isClassroomMember(classroomId) {\n      return isAuthenticated() && classroomId != '' &&\n        exists(/databases/$(database)/documents/classroomMembers/$(classroomId + '_' + request.auth.uid));\n    }\n\n    // A membership document id is always `${classroomId}_${studentId}`, so the\n    // id alone identifies whose membership it is — no document read required.\n    //\n    // This exists because `resource` is NULL when the document does not exist,\n    // and dereferencing null RAISES, which Firestore treats as a denial. The\n    // \"have I already joined?\" check that runs before every join-by-code reads\n    // exactly such a document, so it failed with permission-denied for every\n    // student who had not joined yet — the \"authorization error\" students hit\n    // on the join screen. Granting a read of an id that encodes the caller's\n    // own uid discloses nothing they are not already entitled to see.\n    function isOwnMembershipDocId(membershipId) {\n      return isAuthenticated() && membershipId.matches('.*_' + request.auth.uid);\n    }\n\n    // Classrooms collection\n    match /classrooms/{classroomId} {\n      // Broad read: needed so a student can look up a classroom by code\n      // before joining, and so \"already joined\" checks work. The classroom\n      // doc itself (name/subject/code) is not sensitive; content (posts,\n      // classwork, roster) is gated separately below.\n      allow read: if isAuthenticated();\n      allow create: if isTeacher() && isActiveUser() && request.resource.data.teacherId == request.auth.uid;\n      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;\n      allow update, delete: if isAdmin();\n      // A joining/leaving student must be able to move the roster counter by\n      // exactly one. joinClassroomByCode/leaveClassroom commit the member doc\n      // and this counter in a single atomic batch — without this branch the\n      // WHOLE batch was rejected, which is why joining and leaving both\n      // failed with a misleading \"not allowed to join\" error.\n      allow update: if isStudent() && isActiveUser() &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentCount', 'updatedAt']) &&\n        request.resource.data.studentCount is int &&\n        request.resource.data.studentCount >= 0 &&\n        (request.resource.data.studentCount == resource.data.get('studentCount', 0) + 1 ||\n         request.resource.data.studentCount == resource.data.get('studentCount', 0) - 1);\n    }\n\n    // Classroom membership (\"People\" tab / joined students). Document id is\n    // deterministic `${classroomId}_${studentId}` — this both stops\n    // duplicate joins (a second `create` on the same id is an `update`,\n    // which this rule doesn't grant to students) and lets other collections\n    // cheaply check \"is this student a member\" via exists().\n    match /classroomMembers/{memberId} {\n      // Staff, the member themself, or any fellow member of the same\n      // classroom (so the People tab roster loads for students — previously\n      // a student's roster query was denied outright and the tab silently\n      // rendered \"No students found\").\n      //\n      // The `resource != null` guard is load-bearing for the same reason the\n      // empty-string guard in isClassroomMember() is: a rule that dereferences\n      // a null resource raises, and a raise is a denial.\n      allow read: if isTeacherOrAdmin() ||\n        isOwnMembershipDocId(memberId) ||\n        (resource != null && (\n          (isAuthenticated() && resource.data.studentId == request.auth.uid) ||\n          isClassroomMember(resource.data.get('classroomId', ''))\n        ));\n      // Self-join by code: classroom membership is its own access boundary\n      // now (no separate admin Course/Batch/Section assignment required —\n      // see lib/firebase/classrooms.ts#joinClassroomByCode). The submitted\n      // `teacherId` must match the classroom's real owner so the\n      // denormalized field recomputeAssignedTeacherIds() relies on can't be\n      // spoofed.\n      allow create: if isStudent() && isActiveUser() &&\n        request.resource.data.studentId == request.auth.uid &&\n        memberId == request.resource.data.classroomId + '_' + request.auth.uid &&\n        request.resource.data.teacherId == get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId &&\n        get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.status == 'active';\n      // Teacher-initiated add (manual, or Course/Batch/Section bulk-add) —\n      // only the classroom's own teacher, or an admin, may add a student\n      // this way.\n      allow create: if (\n          (isTeacher() && get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId == request.auth.uid) ||\n          isAdmin()\n        ) &&\n        memberId == request.resource.data.classroomId + '_' + request.resource.data.studentId &&\n        request.resource.data.teacherId == get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId &&\n        get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.status == 'active';\n      // Student leaves, or teacher/admin removes them.\n      allow delete: if isTeacherOrAdmin() ||\n        (isAuthenticated() && resource.data.studentId == request.auth.uid);\n    }\n\n    // Stream posts (announcements/notices/materials)\n    match /classroomPosts/{postId} {\n      allow read: if isTeacherOrAdmin() || isClassroomMember(resource.data.get('classroomId', ''));\n      allow create: if isTeacher() && isActiveUser() && request.resource.data.teacherId == request.auth.uid;\n      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;\n      allow delete: if isAdmin();\n    }\n\n    // Stream comments\n    match /classroomComments/{commentId} {\n      allow read: if isTeacherOrAdmin() || isClassroomMember(resource.data.get('classroomId', ''));\n      allow create: if isAuthenticated() && isActiveUser() &&\n        request.resource.data.authorId == request.auth.uid &&\n        (isTeacherOrAdmin() || isClassroomMember(request.resource.data.get('classroomId', '')));\n      allow delete: if isTeacherOrAdmin() ||\n        (isAuthenticated() && resource.data.authorId == request.auth.uid);\n    }\n\n    // Classwork (assignments/quizzes/materials/resources/links)\n    match /classroomClasswork/{itemId} {\n      // Students only ever see published classwork; drafts are teacher-only.\n      allow read: if isTeacherOrAdmin() ||\n        (resource.data.get('status', '') == 'published' &&\n         isClassroomMember(resource.data.get('classroomId', '')));\n      allow create: if isTeacher() && isActiveUser() && request.resource.data.teacherId == request.auth.uid;\n      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;\n      allow delete: if isAdmin();\n    }\n\n    // Classwork submissions (student hand-in + teacher evaluation).\n    //\n    // Document id is deterministic `${classworkId}_${studentId}`, which is what\n    // makes a duplicate submission impossible: a second `create` on the same id\n    // is an `update`, and the update rules below only ever let a student touch\n    // their OWN document.\n    match /classroomSubmissions/{submissionId} {\n      // The student it belongs to, the classroom's teacher, or an admin.\n      // Students may not read each other's work — an assignment answer is\n      // exactly as sensitive as an exam answer.\n      //\n      // The `resource == null` branch is load-bearing, and its absence was the\n      // \"insufficient permissions\" students hit when handing in an assignment\n      // for the FIRST time. `submitClasswork()` reads the submission document\n      // before writing it (to refuse editing work that has already been\n      // marked), and on a first hand-in that document does not exist yet.\n      // Rules evaluate a missing document with `resource == null`, and\n      // `resource.data.X` on null RAISES — which Firestore treats as a denial.\n      // So the read failed for exactly the students who had never submitted.\n      // The id is `${classworkId}_${studentId}`, so a caller probing their own\n      // is identifiable from the id alone, with no document to read. Same fix\n      // as examAttemptCounters above and classroomMembers below.\n      allow read: if isAdmin() ||\n        (isAuthenticated() && resource == null &&\n         submissionId.matches('.*_' + request.auth.uid)) ||\n        (resource != null && (\n          (isAuthenticated() && resource.data.studentId == request.auth.uid) ||\n          (isTeacher() && resource.data.teacherId == request.auth.uid)\n        ));\n\n      // Hand-in. The student must be a member of the classroom, must be\n      // submitting as themselves, must use the deterministic id, and must\n      // carry the classwork's REAL teacherId — the field the read and grading\n      // rules above trust. Reading it off the classwork document rather than\n      // the request is what stops a student naming any teacher they like.\n      allow create: if isStudent() && isActiveUser() &&\n        request.resource.data.studentId == request.auth.uid &&\n        submissionId == request.resource.data.classworkId + '_' + request.auth.uid &&\n        isClassroomMember(request.resource.data.get('classroomId', '')) &&\n        request.resource.data.status == 'submitted' &&\n        request.resource.data.teacherId ==\n          get(/databases/$(database)/documents/classroomClasswork/$(request.resource.data.classworkId)).data.teacherId &&\n        get(/databases/$(database)/documents/classroomClasswork/$(request.resource.data.classworkId)).data.status == 'published' &&\n        // Grading fields are the teacher's alone. Without this a student could\n        // submit their own work pre-marked.\n        !request.resource.data.keys().hasAny([\n          'marks', 'feedback', 'gradedBy', 'gradedByName', 'gradedAt',\n          'aiSuggestedMarks', 'aiRationale'\n        ]);\n\n      // Revising before it is marked. The allowlist is what keeps `marks`,\n      // `status`, and `late` out of the student's reach — `late` in particular\n      // is resolved once at hand-in and must not be editable afterwards.\n      allow update: if isStudent() && isActiveUser() &&\n        resource.data.studentId == request.auth.uid &&\n        resource.data.status != 'returned' &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'text', 'attachments', 'updatedAt', 'submittedAt'\n        ]);\n\n      // Withdrawing work that has not been marked yet.\n      allow delete: if isAdmin() ||\n        (isStudent() && resource.data.studentId == request.auth.uid &&\n         resource.data.status != 'returned');\n\n      // Evaluation — marks, feedback, returning, and the machine-assisted\n      // pre-pass. Scoped to the classwork's own teacher, not any teacher.\n      allow update: if isAdmin() ||\n        (isTeacher() && isActiveUser() && resource.data.teacherId == request.auth.uid);\n      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;\n    }\n\n    // Email delivery log for classroom notifications — written by the\n    // server (Admin SDK, /api/classroom/notify) which bypasses rules;\n    // these rules only cover the (currently unused) direct-client path.\n    match /classroomEmailLogs/{logId} {\n      allow read: if isTeacherOrAdmin();\n      allow create: if isTeacherOrAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-10T12:31:18.990527Z","metadata":{"services":["cloud.firestore"]}}
