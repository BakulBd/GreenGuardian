[debug] [2026-08-09T19:00:48.254Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/greenguardian2026/rulesets {"name":"projects/greenguardian2026/rulesets/f755ffd6-b19e-4900-822e-57465c0ea1e7","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice firebase.storage {\r\n  match /b/{bucket}/o {\r\n    \r\n    // Helper functions\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n    \r\n    function isUser(userId) {\r\n      return request.auth.uid == userId;\r\n    }\r\n    \r\n    function isImage() {\r\n      return request.resource.contentType.matches('image/.*');\r\n    }\r\n    \r\n    function isPDF() {\r\n      return request.resource.contentType == 'application/pdf';\r\n    }\r\n    \r\n    function isValidFileType() {\r\n      return isImage() || isPDF() || \r\n             request.resource.contentType.matches('text/.*') ||\r\n             request.resource.contentType == 'application/msword' ||\r\n             request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';\r\n    }\r\n    \r\n    function isValidSize() {\r\n      // Max 10MB per file\r\n      return request.resource.size < 10 * 1024 * 1024;\r\n    }\r\n\r\n    // Classroom materials (Phase 2, Feature 1) additionally allow video,\r\n    // zip, and presentation files, with a larger size ceiling for video.\r\n    function isClassroomFileType() {\r\n      return isValidFileType() ||\r\n        request.resource.contentType.matches('video/.*') ||\r\n        request.resource.contentType == 'application/zip' ||\r\n        request.resource.contentType == 'application/x-zip-compressed' ||\r\n        request.resource.contentType == 'application/vnd.ms-powerpoint' ||\r\n        request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation';\r\n    }\r\n\r\n    function isClassroomFileSize() {\r\n      // Max 100MB per file (materials can include short video clips).\r\n      return request.resource.size < 100 * 1024 * 1024;\r\n    }\r\n    \r\n    // User avatars\r\n    match /avatars/{userId}/{fileName} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isUser(userId) && isImage() && isValidSize();\r\n      allow delete: if isUser(userId);\r\n    }\r\n    \r\n    // Exam answer uploads\r\n    match /answers/{allPaths=**} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isAuthenticated() && isValidFileType() && isValidSize();\r\n    }\r\n    \r\n    // Proctoring snapshots & screenshots\r\n    match /proctoring/{allPaths=**} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isAuthenticated() && isValidFileType() && isValidSize();\r\n    }\r\n    \r\n    // Warning screenshots — permanent proctoring evidence (Task 9).\r\n    // Delete is split out from create/update: a delete request has no\r\n    // request.resource, so folding it into the size/type-checked `write`\r\n    // rule below would silently deny every delete attempt.\r\n    //\r\n    // Deletion is server-only (see /api/proctoring/snapshots). Evidence of a\r\n    // proctoring warning must not be deletable by the student it was raised\r\n    // against — `isAuthenticated()` here would let exactly that happen, since\r\n    // any signed-in user (including the accused student) satisfies it.\r\n    // Ownership (teacher owns the exam / admin) is checked server-side with\r\n    // the Admin SDK, which rules cannot express (it would need to read the\r\n    // related exam/session document to know who \"owns\" a given screenshot).\r\n    match /warningScreenshots/{allPaths=**} {\r\n      allow read: if isAuthenticated();\r\n      allow create, update: if isAuthenticated() && isImage() && isValidSize();\r\n      allow delete: if false;\r\n    }\r\n    \r\n    // Exam papers and materials\r\n    match /exams/{allPaths=**} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isAuthenticated() && isValidFileType() && isValidSize();\r\n      allow delete: if isAuthenticated();\r\n    }\r\n\r\n    // Classroom stream/classwork attachments (Phase 2, Feature 1)\r\n    match /classrooms/{allPaths=**} {\r\n      allow read: if isAuthenticated();\r\n      allow create, update: if isAuthenticated() && isClassroomFileType() && isClassroomFileSize();\r\n      allow delete: if isAuthenticated();\r\n    }\r\n    \r\n    // General uploads\r\n    match /uploads/{userId}/{fileName} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isUser(userId) && isValidFileType() && isValidSize();\r\n      allow delete: if isUser(userId);\r\n    }\r\n  }\r\n}\r\n","name":"storage.rules"}]},"createTime":"2026-08-09T19:00:47.429039Z","metadata":{"services":["firebase.storage"]}}
