[debug] [2026-08-09T19:00:51.852Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/greenguardian2026/rulesets {"name":"projects/greenguardian2026/rulesets/976039c5-ca09-4ba6-9ef2-502d99431e54","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    \r\n    // Helper functions\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n    \r\n    function isUser(userId) {\r\n      return isAuthenticated() && request.auth.uid == userId;\r\n    }\r\n    \r\n    function getUserData() {\r\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\r\n    }\r\n    \r\n    function isAdmin() {\r\n      return isAuthenticated() && getUserData().role == 'admin';\r\n    }\r\n    \r\n    function isTeacher() {\r\n      return isAuthenticated() && getUserData().role == 'teacher';\r\n    }\r\n    \r\n    function isStudent() {\r\n      return isAuthenticated() && getUserData().role == 'student';\r\n    }\r\n    \r\n    function isTeacherOrAdmin() {\r\n      return isAdmin() || isTeacher();\r\n    }\r\n\r\n    // Accounts an admin has put on hold or suspended may not perform actions\r\n    // (start/submit exams, create content). Missing `status` == active.\r\n    function isActiveUser() {\r\n      return isAuthenticated() && getUserData().get('status', 'active') == 'active';\r\n    }\r\n\r\n    // Deterministic per-student-per-exam attempt counter document ID,\r\n    // shared by the examAttemptCounters rules and the examSessions create\r\n    // rule below (Task 4 — exam attempt limits).\r\n    function attemptCounterId(examId, studentId) {\r\n      return examId + '_' + studentId;\r\n    }\r\n\r\n    // Is the requesting teacher one this student is actually assigned to?\r\n    // (Phase 2 Feature 6.) Looks up the STUDENT's own assignedTeacherIds\r\n    // rather than requiring a denormalized teacher->students list — reuses\r\n    // the same field Task 10 already maintains.\r\n    function isAssignedToStudent(studentId) {\r\n      return isAuthenticated() &&\r\n        request.auth.uid in get(/databases/$(database)/documents/users/$(studentId)).data.get('assignedTeacherIds', []);\r\n    }\r\n    \r\n    // Users collection\r\n    match /users/{userId} {\r\n      // Authenticated users (students, teachers, admins) can read user profiles\r\n      allow read: if isAuthenticated();\r\n      \r\n      // Users can only create their own document during registration\r\n      allow create: if isUser(userId) && \r\n                      request.resource.data.id == userId &&\r\n                      request.resource.data.email == request.auth.token.email &&\r\n                      request.resource.data.role in ['student', 'teacher'] &&\r\n                      (!request.resource.data.keys().hasAny(['approved']) || \r\n                       request.resource.data.role == 'student' && request.resource.data.approved == true ||\r\n                       request.resource.data.role == 'teacher' && request.resource.data.approved == false);\r\n      \r\n      // Users can update their own profile — name, phone, avatar, and the\r\n      // mustChangePassword acknowledgement. Everything that decides ACCESS is\r\n      // excluded and stays server/admin-owned:\r\n      //\r\n      //   role, approved, rejected, id, status\r\n      //     — identity and account state.\r\n      //   assignedTeacherIds\r\n      //     — the field the notice and exam rules trust to decide whose content\r\n      //       a student may read. Self-writable, it would let any student grant\r\n      //       themselves another teacher's communications. Written only by the\r\n      //       Admin SDK (lib/server/roster.ts, /api/classroom/sync-access).\r\n      //   batch, section, sections, studentCode, department\r\n      //     — academic placement. This is the INPUT the roster is derived from,\r\n      //       so leaving it self-writable is the same hole one step removed: a\r\n      //       student could move into any section and pick up that section's\r\n      //       exams and notices on the next roster sync. Changed by an admin\r\n      //       via the Students page, which resyncs the roster with it.\r\n      allow update: if isUser(userId) &&\r\n                       !request.resource.data.diff(resource.data).affectedKeys().hasAny([\r\n                         'role', 'approved', 'rejected', 'id', 'status',\r\n                         'assignedTeacherIds',\r\n                         'batch', 'section', 'sections', 'studentCode', 'department'\r\n                       ]);\r\n      \r\n      // Admins can update any user (for approval/rejection)\r\n      allow update: if isAdmin();\r\n      \r\n      // Only admins can delete users\r\n      allow delete: if isAdmin();\r\n    }\r\n    \r\n    // Pending Registrations collection (email-verification flow)\r\n    // This collection is written ONLY by the Firebase Admin SDK (server-side\r\n    // API routes) using server credentials, which bypass security rules.\r\n    // Clients must never read or write these sensitive records.\r\n    match /pendingRegistrations/{registrationId} {\r\n      allow read, write: if false;\r\n    }\r\n    \r\n    // Exams collection\r\n    match /exams/{examId} {\r\n      // Teachers can read their own exams (any status).\r\n      allow read: if isTeacher() && (resource.data.teacherId == request.auth.uid || resource.data.createdBy == request.auth.uid);\r\n      // Admins can read any exam.\r\n      allow read: if isAdmin();\r\n      // Students can only read an exam they were specifically targeted for —\r\n      // `targetStudentIds` is resolved at creation time from the teacher's\r\n      // Course+Batch+Section assignment (see computeAssignmentTargetStudentIds\r\n      // in lib/firebase/assignments.ts). Exams created before this field\r\n      // existed stay invisible until an admin runs the one-time\r\n      // backfillExamTargetStudentIds() — same fail-closed-until-backfilled\r\n      // tradeoff already used for `assignedTeacherIds`.\r\n      //\r\n      // `completed`/`archived` are included deliberately: a student must be\r\n      // able to re-open /exam/{id}/review after the teacher closes the exam,\r\n      // and ExamClient re-reads the exam doc while grading a submission. The\r\n      // listing query (subscribeToStudentVisibleExams) filters to\r\n      // published/active itself, so a closed exam still never appears as\r\n      // startable — this only keeps already-earned results readable.\r\n      allow read: if isStudent() &&\r\n                     resource.data.status in ['published', 'active', 'completed', 'archived'] &&\r\n                     request.auth.uid in resource.data.get('targetStudentIds', []);\r\n\r\n      // Teachers can create exams\r\n      allow create: if isTeacher() && isActiveUser() &&\r\n                       request.resource.data.teacherId == request.auth.uid &&\r\n                       request.resource.data.status in ['draft', 'published'];\r\n\r\n      // Teachers can update their own exams\r\n      allow update: if isTeacher() && isActiveUser() && (resource.data.teacherId == request.auth.uid || resource.data.createdBy == request.auth.uid);\r\n      \r\n      // Admins can update/delete any exam\r\n      allow update, delete: if isAdmin();\r\n      \r\n      // Teachers can delete their own exams\r\n      allow delete: if isTeacher() && (resource.data.teacherId == request.auth.uid || resource.data.createdBy == request.auth.uid);\r\n    }\r\n    \r\n    // Questions collection\r\n    match /questions/{questionId} {\r\n      // Staff can read any question (needed by the exam builder/review UIs).\r\n      //\r\n      // Students get NO read access here at all. Question documents carry\r\n      // `correctAnswer`, and no rule can hand a student the question text\r\n      // without also handing them the key. Their paper is served instead by\r\n      // `/api/exams/paper`, which strips the key server-side, and their\r\n      // submission is graded by `/api/exams/grade`, which reads this\r\n      // collection with the Admin SDK. After submitting, the answer key\r\n      // reaches the student through `answers/{id}.questionSnapshot` — written\r\n      // by the grading route, once the attempt is over.\r\n      allow read: if isTeacherOrAdmin();\r\n\r\n      // Teachers can create questions for their exams\r\n      allow create: if isTeacher() && \r\n                       exists(/databases/$(database)/documents/exams/$(request.resource.data.examId)) &&\r\n                       get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.teacherId == request.auth.uid;\r\n      \r\n      // Teachers can update/delete questions for their exams\r\n      allow update, delete: if isTeacher() && \r\n                               exists(/databases/$(database)/documents/exams/$(resource.data.examId)) &&\r\n                               get(/databases/$(database)/documents/exams/$(resource.data.examId)).data.teacherId == request.auth.uid;\r\n      \r\n      // Admins can do everything\r\n      allow update, delete: if isAdmin();\r\n    }\r\n    \r\n    // Exam Sessions collection\r\n    match /examSessions/{sessionId} {\r\n      // Students can read their own sessions\r\n      allow read: if isUser(resource.data.studentId);\r\n      \r\n      // Teachers and admins can read sessions for monitoring and evaluation\r\n      allow read: if isTeacherOrAdmin();\r\n      \r\n      // Students can create their own sessions. attemptNumber must be a\r\n      // positive integer within the exam's attemptsAllowed cap, and must\r\n      // equal (pre-write counter value + 1) / 1 if no counter exists yet.\r\n      // The client writes the matching examAttemptCounters update in the\r\n      // same transaction (see ExamClient.startExam) — since rule `get()`\r\n      // calls inside a transaction see the pre-transaction snapshot, this\r\n      // is safe against a crafted client trying to skip the counter or\r\n      // claim an attempt number a real transaction wouldn't produce.\r\n      allow create: if isAuthenticated() && isActiveUser() &&\r\n               request.resource.data.studentId == request.auth.uid &&\r\n               exists(/databases/$(database)/documents/exams/$(request.resource.data.examId)) &&\r\n               request.resource.data.attemptNumber is int &&\r\n               request.resource.data.attemptNumber >= 1 &&\r\n               request.resource.data.attemptNumber <=\r\n                 get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.get('attemptsAllowed', 1) &&\r\n               request.resource.data.attemptNumber == (\r\n                 exists(/databases/$(database)/documents/examAttemptCounters/$(attemptCounterId(request.resource.data.examId, request.auth.uid)))\r\n                   ? get(/databases/$(database)/documents/examAttemptCounters/$(attemptCounterId(request.resource.data.examId, request.auth.uid))).data.count + 1\r\n                   : 1\r\n               );\r\n\r\n      // Students can update their own sessions, but only the fields their own\r\n      // browser is the source of: autosaved answers, the proctoring counters\r\n      // its sensors produce, and the lifecycle transitions it drives\r\n      // (resume, and closing out an attempt whose time expired offline).\r\n      //\r\n      // Every scoring field is excluded. `score`, `totalMarks`, `accuracy`,\r\n      // `correctAnswers`, `wrongAnswers`, `grading`, `flagged`, … are written\r\n      // ONLY by /api/exams/grade through the Admin SDK. Until this allowlist\r\n      // existed, a student could PATCH their own session with `score: 100`:\r\n      // grading ran in their browser, so the rules had no way to tell a real\r\n      // score from an invented one, and simply trusted whatever arrived.\r\n      allow update: if isUser(resource.data.studentId) && isActiveUser() &&\r\n                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([\r\n                         'savedAnswers', 'updatedAt', 'status', 'submitted',\r\n                         'completedAt', 'reason', 'resumedAt',\r\n                         'warnings', 'behaviorScore', 'violationCounts', 'proctoring'\r\n                       ]);\r\n\r\n      // Teachers and admins can update sessions for monitoring\r\n      allow update: if isTeacherOrAdmin() && isActiveUser();\r\n    }\r\n\r\n    // Exam attempt counters — one document per (exam, student) pair,\r\n    // backing the attempt-limit enforcement above (Task 4).\r\n    match /examAttemptCounters/{counterId} {\r\n      // `resource == null` short-circuits before dereferencing `.data` — a\r\n      // student's first attempt at any exam reads this doc before it exists\r\n      // (see ExamClient.startExam's transaction), and resource.data.X on a\r\n      // nonexistent doc throws in rules, which is treated as a denial. That\r\n      // was silently blocking every first attempt.\r\n      allow read: if isTeacherOrAdmin() ||\r\n        (isAuthenticated() && (resource == null || resource.data.studentId == request.auth.uid));\r\n      allow create: if isAuthenticated() && isActiveUser() &&\r\n        request.resource.data.studentId == request.auth.uid &&\r\n        request.resource.data.count == 1;\r\n      allow update: if isAuthenticated() && isActiveUser() &&\r\n        resource.data.studentId == request.auth.uid &&\r\n        request.resource.data.count == resource.data.count + 1;\r\n    }\r\n\r\n    // Answers collection\r\n    match /answers/{answerId} {\r\n      // Students can read their own answers\r\n      allow read: if isUser(resource.data.studentId);\r\n      \r\n      // Teachers and admins can read answers\r\n      allow read: if isTeacherOrAdmin();\r\n      \r\n      // Submissions are CREATED server-side only (/api/exams/grade, Admin SDK,\r\n      // which bypasses these rules). A student-created answer document was how\r\n      // a submission used to arrive, carrying a browser-computed `score` that\r\n      // nothing could verify — the document and its grade are now written\r\n      // together by the server from the answer key.\r\n      //\r\n      // The one thing a student still writes here is the result of the\r\n      // background OCR pass on their own upload-mode submission, which runs in\r\n      // their browser after submitting.\r\n      allow update: if isAuthenticated() && isActiveUser() &&\r\n               resource.data.studentId == request.auth.uid &&\r\n               request.resource.data.diff(resource.data).affectedKeys().hasOnly([\r\n                 'ocrAnalysis', 'ocrText', 'ocrStatus'\r\n               ]);\r\n\r\n      // Teachers and admins can update answers (for grading, OCR analysis & similarity reports)\r\n      allow update: if isTeacherOrAdmin() && isActiveUser();\r\n    }\r\n\r\n    // Similarity Reports collection\r\n    //\r\n    // Written exclusively by /api/plagiarism/check via the Admin SDK. Client\r\n    // writes are denied outright: this collection holds the verdict on whether\r\n    // a student plagiarised, and `allow create, update: if isAuthenticated()`\r\n    // let the accused student overwrite it with a clean score.\r\n    //\r\n    // Reads are STAFF-ONLY, including for the student the report is about: the\r\n    // `matches` array names the classmates whose answers theirs resembled and\r\n    // by how much. The student sees only their own verdict, via\r\n    // `similarityScore`/`similarityLevel` on their answer document.\r\n    match /similarityReports/{reportId} {\r\n      allow read: if isTeacherOrAdmin();\r\n      allow write: if false;\r\n    }\r\n\r\n    // ============ Live Exam Video (see lib/services/liveVideo.ts) ============\r\n\r\n    // WebRTC signaling: the student publishes offers/ICE, each watching teacher\r\n    // registers a presence document under `viewers` and answers there.\r\n    match /liveVideoSignaling/{sessionId} {\r\n      allow read: if isAuthenticated();\r\n      // Only the broadcasting student (or staff) may own the room document.\r\n      allow create, update: if isTeacherOrAdmin() ||\r\n        (isAuthenticated() && request.resource.data.studentId == request.auth.uid);\r\n      allow delete: if isTeacherOrAdmin() ||\r\n        (isAuthenticated() && resource.data.studentId == request.auth.uid);\r\n\r\n      match /viewers/{viewerId}/{allPaths=**} {\r\n        // Signaling payloads are ephemeral SDP/ICE blobs; both peers need\r\n        // read/write access to complete the handshake.\r\n        allow read, write: if isAuthenticated();\r\n      }\r\n    }\r\n\r\n    // Firestore frame relay — the transport that makes live video work without\r\n    // a VPS/TURN server. Written by the student, read by teachers/admins.\r\n    match /liveFrames/{sessionId} {\r\n      allow read: if isTeacherOrAdmin() ||\r\n        (isAuthenticated() && resource.data.studentId == request.auth.uid);\r\n      allow create, update: if isAuthenticated() &&\r\n        request.resource.data.studentId == request.auth.uid;\r\n      allow delete: if isTeacherOrAdmin() ||\r\n        (isAuthenticated() && resource.data.studentId == request.auth.uid);\r\n    }\r\n    \r\n    // Exam Logs collection\r\n    match /examLogs/{logId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if isAuthenticated();\r\n    }\r\n\r\n    // Proctoring Events collection\r\n    // Proctoring evidence (events, webcam snapshots, warning screenshots).\r\n    //\r\n    // Students WRITE these from the exam client but never read them back; only\r\n    // the teacher invigilation surfaces do. Read used to be `isAuthenticated()`,\r\n    // which let any signed-in student pull every other student's webcam\r\n    // captures and violation history straight out of Firestore.\r\n    // Own-session reads stay allowed so a student can still see their own\r\n    // record if a future screen needs it.\r\n    match /proctoringEvents/{eventId} {\r\n      allow read: if isTeacherOrAdmin() || isUser(resource.data.studentId);\r\n      allow create: if isAuthenticated();\r\n    }\r\n\r\n    // Proctoring Snapshots collection\r\n    match /proctoringSnapshots/{snapshotId} {\r\n      allow read: if isTeacherOrAdmin() || isUser(resource.data.studentId);\r\n      allow create: if isAuthenticated();\r\n    }\r\n\r\n    // Warning Screenshots collection — permanent proctoring evidence\r\n    // captured on every warning (Task 9's Snapshots gallery).\r\n    match /warningScreenshots/{screenshotId} {\r\n      allow read: if isTeacherOrAdmin() || isUser(resource.data.studentId);\r\n      allow create: if isAuthenticated();\r\n      allow delete: if isTeacherOrAdmin();\r\n    }\r\n\r\n    // Settings collection (admin only)\r\n    match /settings/{settingId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    // ============ Course / Batch / Section Management ============\r\n\r\n    // Courses collection\r\n    match /courses/{courseId} {\r\n      // Any authenticated user can read courses (needed for forms across teacher/student panels)\r\n      allow read: if isAuthenticated();\r\n      // Only admins can create/update/delete courses\r\n      allow create: if isAdmin();\r\n      allow update: if isAdmin();\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // Batches collection\r\n    match /batches/{batchId} {\r\n      // Any authenticated user can read batches\r\n      allow read: if isAuthenticated();\r\n      // Only admins can create/update/delete batches\r\n      allow create: if isAdmin();\r\n      allow update: if isAdmin();\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // Sections collection\r\n    match /sections/{sectionId} {\r\n      // Any authenticated user can read sections\r\n      allow read: if isAuthenticated();\r\n      // Only admins can create/update/delete sections\r\n      allow create: if isAdmin();\r\n      allow update: if isAdmin();\r\n      allow delete: if isAdmin();\r\n    }\r\n    \r\n    // Teacher Applications collection (optional)\r\n    match /teacherApplications/{applicationId} {\r\n      allow read: if isAdmin() || isUser(resource.data.userId);\r\n      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;\r\n      allow update: if isAdmin();\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // ============ Results Module ============\r\n\r\n    // Results collection\r\n    match /results/{resultId} {\r\n      // Students can only read their own published results\r\n      allow read: if isStudent() && resource.data.studentId == request.auth.uid && resource.data.isPublished == true;\r\n      // Teachers can only read results for their own assigned students —\r\n      // the comment here used to claim \"via batch/section filtering\" but no\r\n      // such check actually existed, letting any teacher read any student's\r\n      // results (Phase 2 Feature 6 audit finding).\r\n      allow read: if isTeacher() && isAssignedToStudent(resource.data.studentId);\r\n      // Admins can read all results\r\n      allow read: if isAdmin();\r\n      // Only teachers and admins can create results\r\n      allow create: if isTeacherOrAdmin() && request.resource.data.studentId != null;\r\n      // Only teachers and admins can update results\r\n      allow update: if isTeacherOrAdmin();\r\n      // Only admins can delete results\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // Student Warnings collection\r\n    match /studentWarnings/{warningId} {\r\n      // Students can only read their own warnings\r\n      allow read: if isStudent() && resource.data.studentId == request.auth.uid;\r\n      // Teachers can only read warnings for their own assigned students\r\n      // (Phase 2 Feature 6 audit finding — same gap as `results` above).\r\n      allow read: if isTeacher() && isAssignedToStudent(resource.data.studentId);\r\n      // Admins can read all warnings\r\n      allow read: if isAdmin();\r\n      // Only teachers and admins can create warnings\r\n      allow create: if isTeacherOrAdmin() && request.resource.data.studentId != null;\r\n      // Only teachers and admins can update warnings\r\n      allow update: if isTeacherOrAdmin();\r\n      // Only admins can delete warnings\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // Result Notifications collection (for real-time update signaling).\r\n    // Not currently written or read by any app code (confirmed unused,\r\n    // Phase 2 Feature 6 audit), but `allow read: if isAuthenticated()` let\r\n    // any signed-in student read every other student's signal — tightened\r\n    // to staff-only in case this is wired up later.\r\n    match /resultNotifications/{notificationId} {\r\n      allow read: if isTeacherOrAdmin();\r\n      allow create: if isTeacherOrAdmin();\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // ============ Notice Module ============\r\n\r\n    // Notices collection\r\n    match /notices/{noticeId} {\r\n      // Students can only read PUBLISHED notices that are actually addressed to\r\n      // them AND whose teacher is one an admin actually assigned this student\r\n      // to (Task 10 — teacher communication only reaches assigned students).\r\n      // These conditions mirror the queries in getStudentNotices() — keep\r\n      // the two in sync or student notice lists will fail with permission-denied.\r\n      allow read: if isStudent() &&\r\n                     resource.data.status == 'published' &&\r\n                     resource.data.teacherId in getUserData().get('assignedTeacherIds', []) && (\r\n                       resource.data.targetType == 'all' ||\r\n                       (resource.data.targetType == 'individual' &&\r\n                        request.auth.uid in resource.data.get('targetStudentIds', [])) ||\r\n                       (resource.data.targetType in ['batch', 'semester'] &&\r\n                        resource.data.get('targetBatch', '') == getUserData().get('batch', '')) ||\r\n                       (resource.data.targetType == 'section' &&\r\n                        resource.data.get('targetSection', '') == getUserData().get('section', '') &&\r\n                        // Section names repeat across batches (\"D1\" exists in\r\n                        // 232 and 241), so a section notice must also match the\r\n                        // student's batch. Notices created before the batch\r\n                        // selector existed have no targetBatch and stay\r\n                        // section-only. Mirrored in getStudentNotices().\r\n                        (resource.data.get('targetBatch', '') == '' ||\r\n                         resource.data.get('targetBatch', '') == getUserData().get('batch', ''))) ||\r\n                       (resource.data.targetType == 'course' &&\r\n                        resource.data.get('targetCourseId', '') in getUserData().get('courses', []))\r\n                     );\r\n      // Teachers can read their own notices (draft or published)\r\n      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;\r\n      // Admins can read all notices\r\n      allow read: if isAdmin();\r\n      // Teachers can create notices\r\n      allow create: if isTeacher() && isActiveUser() &&\r\n                       request.resource.data.teacherId == request.auth.uid &&\r\n                       request.resource.data.status in ['draft', 'published'];\r\n      // Teachers can update their own notices\r\n      allow update: if isTeacher() && isActiveUser() && resource.data.teacherId == request.auth.uid;\r\n      // Admins can update any notice\r\n      allow update: if isAdmin();\r\n      // Teachers can delete their own notices\r\n      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;\r\n      // Admins can delete any notice\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // Notice Reads collection\r\n    match /noticeReads/{readId} {\r\n      // Students can read their own read status\r\n      allow read: if isStudent() && resource.data.studentId == request.auth.uid;\r\n      // Teachers can read read status for their notices\r\n      allow read: if isTeacher();\r\n      // Admins can read all\r\n      allow read: if isAdmin();\r\n      // Students can mark notices as read\r\n      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;\r\n      // Staff clean these up when a notice is deleted (without this, deleting a\r\n      // notice that anyone had read failed with permission-denied).\r\n      allow delete: if isTeacherOrAdmin();\r\n    }\r\n\r\n// Notifications collection\r\n    match /notifications/{notificationId} {\r\n      // Users can read their own notifications\r\n      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;\r\n      // Staff can read them to report delivery and to clean up deleted notices\r\n      allow read: if isTeacherOrAdmin();\r\n      // Teachers and admins create notifications when publishing notices\r\n      allow create: if isTeacherOrAdmin() &&\r\n                       request.resource.data.type == 'notice' &&\r\n                       request.resource.data.userId != null &&\r\n                       request.resource.data.noticeId != null;\r\n      // Users can update their own notifications (mark as read)\r\n      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&\r\n                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);\r\n      // Admin can manage\r\n      allow update: if isAdmin();\r\n      // Staff remove a notice's notifications when the notice is deleted.\r\n      allow delete: if isTeacherOrAdmin();\r\n    }\r\n\r\n    // ============ Teacher Assignment Module ============\r\n\r\n    // teacher_assignments collection\r\n    match /teacher_assignments/{assignmentId} {\r\n      // Teachers can read their own assignments\r\n      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;\r\n      // Admins can read all assignments\r\n      allow read: if isAdmin();\r\n      // Only admins can create/update/delete assignments\r\n      allow create: if isAdmin();\r\n      allow update: if isAdmin();\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // teacher_student_mapping collection\r\n    match /teacher_student_mapping/{mappingId} {\r\n      // Teachers can read mappings where they are the teacher\r\n      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;\r\n      // Admins can read all mappings\r\n      allow read: if isAdmin();\r\n      // Only admins can create/update/delete mappings\r\n      allow create: if isAdmin();\r\n      allow update: if isAdmin();\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // ============ Classroom Module (Phase 2, Feature 1) ============\r\n\r\n    function isClassroomMember(classroomId) {\r\n      return isAuthenticated() &&\r\n        exists(/databases/$(database)/documents/classroomMembers/$(classroomId + '_' + request.auth.uid));\r\n    }\r\n\r\n    // Classrooms collection\r\n    match /classrooms/{classroomId} {\r\n      // Broad read: needed so a student can look up a classroom by code\r\n      // before joining, and so \"already joined\" checks work. The classroom\r\n      // doc itself (name/subject/code) is not sensitive; content (posts,\r\n      // classwork, roster) is gated separately below.\r\n      allow read: if isAuthenticated();\r\n      allow create: if isTeacher() && isActiveUser() && request.resource.data.teacherId == request.auth.uid;\r\n      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;\r\n      allow update, delete: if isAdmin();\r\n      // A joining/leaving student must be able to move the roster counter by\r\n      // exactly one. joinClassroomByCode/leaveClassroom commit the member doc\r\n      // and this counter in a single atomic batch — without this branch the\r\n      // WHOLE batch was rejected, which is why joining and leaving both\r\n      // failed with a misleading \"not allowed to join\" error.\r\n      allow update: if isStudent() && isActiveUser() &&\r\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentCount', 'updatedAt']) &&\r\n        request.resource.data.studentCount is int &&\r\n        request.resource.data.studentCount >= 0 &&\r\n        (request.resource.data.studentCount == resource.data.get('studentCount', 0) + 1 ||\r\n         request.resource.data.studentCount == resource.data.get('studentCount', 0) - 1);\r\n    }\r\n\r\n    // Classroom membership (\"People\" tab / joined students). Document id is\r\n    // deterministic `${classroomId}_${studentId}` — this both stops\r\n    // duplicate joins (a second `create` on the same id is an `update`,\r\n    // which this rule doesn't grant to students) and lets other collections\r\n    // cheaply check \"is this student a member\" via exists().\r\n    match /classroomMembers/{memberId} {\r\n      // Staff, the member themself, or any fellow member of the same\r\n      // classroom (so the People tab roster loads for students — previously\r\n      // a student's roster query was denied outright and the tab silently\r\n      // rendered \"No students found\").\r\n      allow read: if isTeacherOrAdmin() ||\r\n        (isAuthenticated() && resource.data.studentId == request.auth.uid) ||\r\n        isClassroomMember(resource.data.classroomId);\r\n      // Self-join by code: classroom membership is its own access boundary\r\n      // now (no separate admin Course/Batch/Section assignment required —\r\n      // see lib/firebase/classrooms.ts#joinClassroomByCode). The submitted\r\n      // `teacherId` must match the classroom's real owner so the\r\n      // denormalized field recomputeAssignedTeacherIds() relies on can't be\r\n      // spoofed.\r\n      allow create: if isStudent() && isActiveUser() &&\r\n        request.resource.data.studentId == request.auth.uid &&\r\n        memberId == request.resource.data.classroomId + '_' + request.auth.uid &&\r\n        request.resource.data.teacherId == get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId &&\r\n        get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.status == 'active';\r\n      // Teacher-initiated add (manual, or Course/Batch/Section bulk-add) —\r\n      // only the classroom's own teacher, or an admin, may add a student\r\n      // this way.\r\n      allow create: if (\r\n          (isTeacher() && get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId == request.auth.uid) ||\r\n          isAdmin()\r\n        ) &&\r\n        memberId == request.resource.data.classroomId + '_' + request.resource.data.studentId &&\r\n        request.resource.data.teacherId == get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId &&\r\n        get(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.status == 'active';\r\n      // Student leaves, or teacher/admin removes them.\r\n      allow delete: if isTeacherOrAdmin() ||\r\n        (isAuthenticated() && resource.data.studentId == request.auth.uid);\r\n    }\r\n\r\n    // Stream posts (announcements/notices/materials)\r\n    match /classroomPosts/{postId} {\r\n      allow read: if isTeacherOrAdmin() || isClassroomMember(resource.data.classroomId);\r\n      allow create: if isTeacher() && isActiveUser() && request.resource.data.teacherId == request.auth.uid;\r\n      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // Stream comments\r\n    match /classroomComments/{commentId} {\r\n      allow read: if isTeacherOrAdmin() || isClassroomMember(resource.data.classroomId);\r\n      allow create: if isAuthenticated() && isActiveUser() &&\r\n        request.resource.data.authorId == request.auth.uid &&\r\n        (isTeacherOrAdmin() || isClassroomMember(request.resource.data.classroomId));\r\n      allow delete: if isTeacherOrAdmin() ||\r\n        (isAuthenticated() && resource.data.authorId == request.auth.uid);\r\n    }\r\n\r\n    // Classwork (assignments/quizzes/materials/resources/links)\r\n    match /classroomClasswork/{itemId} {\r\n      // Students only ever see published classwork; drafts are teacher-only.\r\n      allow read: if isTeacherOrAdmin() ||\r\n        (resource.data.status == 'published' && isClassroomMember(resource.data.classroomId));\r\n      allow create: if isTeacher() && isActiveUser() && request.resource.data.teacherId == request.auth.uid;\r\n      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // Email delivery log for classroom notifications — written by the\r\n    // server (Admin SDK, /api/classroom/notify) which bypasses rules;\r\n    // these rules only cover the (currently unused) direct-client path.\r\n    match /classroomEmailLogs/{logId} {\r\n      allow read: if isTeacherOrAdmin();\r\n      allow create: if isTeacherOrAdmin();\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-08-09T19:00:51.018751Z","metadata":{"services":["cloud.firestore"]}}
